/* ===== 全局设计基座：色板 / 间距 / 圆角 / 通用组件 =====
   改主题色只改下面这几个变量，五个 tab 页会一起跟着变 */
page {
  --brand: #5046E5;
  --brand-1: #6D5BFF;
  --brand-2: #3B82F6;
  --brand-soft: #EEF0FF;
  --ink: #1E2233;
  --ink-2: #4B5266;
  --muted: #8A90A6;
  --line: #EDF0F7;
  --bg: #F3F6FD;
  --card: #FFFFFF;
  --danger: #FF6B6B;
  --ok: #1FBF75;
  --warn: #FFB020;
  --radius: 28rpx;
  --radius-sm: 18rpx;
  --gap: 24rpx;
  --shadow: 0 10rpx 30rpx rgba(37, 63, 183, 0.08);
  background-color: var(--bg);
  background-image: linear-gradient(180deg, #EDF1FB 0%, #F6F8FE 100%);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.6;
}

view, text, scroll-view { box-sizing: border-box; }

/* 页面容器：给底部 tabBar/悬浮按钮留出安全距离 */
.container { padding: 0 0 40rpx; min-height: 100vh; }
.container-tight { padding: 0; }

/* ===== 卡片 ===== */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin: var(--gap);
  box-shadow: var(--shadow);
  border: 1rpx solid rgba(37, 63, 183, 0.05);
}
.card-flat { box-shadow: none; border: 1rpx solid var(--line); }
.card-tap { transition: transform .15s ease, box-shadow .15s ease; }
.card-tap:active { transform: scale(.985); box-shadow: 0 4rpx 14rpx rgba(37, 63, 183, 0.14); }

/* ===== 章节标题 ===== */
.section { display: flex; align-items: baseline; justify-content: space-between; margin: 36rpx var(--gap) 8rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.section-sub { font-size: 24rpx; color: var(--muted); }

/* ===== 文字 ===== */
.title { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.desc { font-size: 24rpx; color: var(--muted); }
.ink-2 { font-size: 26rpx; color: var(--ink-2); }
.num { font-variant-numeric: tabular-nums; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ellipsis-2 {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; text-overflow: ellipsis;
}

/* ===== 按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%);
  color: #FFFFFF; border-radius: 20rpx; padding: 22rpx 44rpx;
  text-align: center; font-weight: 600; font-size: 30rpx;
  box-shadow: 0 10rpx 24rpx rgba(79, 90, 255, 0.35);
}
.btn-primary:active { opacity: .92; transform: scale(.98); }
.btn-ghost {
  border: 1rpx solid rgba(80, 70, 229, .28); color: var(--brand);
  border-radius: 44rpx; padding: 12rpx 30rpx; font-size: 26rpx; text-align: center;
}
.btn-ghost:active { background: var(--brand-soft); }
.btn-disabled { opacity: .5; }

/* ===== 标签 / 徽标 ===== */
.chip {
  display: inline-block; padding: 6rpx 22rpx; border-radius: 24rpx;
  font-size: 22rpx; background: var(--brand-soft); color: var(--brand);
}
.badge {
  display: inline-flex; align-items: center; padding: 6rpx 18rpx; border-radius: 999rpx;
  font-size: 22rpx; background: rgba(80, 70, 229, .10); color: var(--brand);
}
.badge-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 10rpx; }

/* ===== 列表行 ===== */
.list-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx; background: var(--card);
}
.list-row + .list-row { border-top: 1rpx solid var(--line); }
.list-row:active { background: #FAFBFF; }
.arrow { color: var(--muted); font-size: 26rpx; }

/* ===== 空态 / 加载 ===== */
.empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 40rpx; color: var(--muted); }
.empty-emoji { font-size: 64rpx; margin-bottom: 16rpx; opacity: .8; }
.empty-text { font-size: 26rpx; }
.skeleton {
  background: linear-gradient(90deg, #EEF1F8 25%, #F7F9FF 37%, #EEF1F8 63%);
  background-size: 400% 100%; animation: sk 1.2s ease-in-out infinite; border-radius: 12rpx;
}
@keyframes sk { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
.loading-text { text-align: center; color: var(--muted); font-size: 24rpx; padding: 30rpx; }

/* ===== 弹层 ===== */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(20, 24, 45, .45); z-index: 90; }
.dialog {
  position: fixed; left: 40rpx; right: 40rpx; top: 50%; transform: translateY(-50%);
  background: var(--card); border-radius: 32rpx; padding: 36rpx; z-index: 95;
  box-shadow: 0 20rpx 60rpx rgba(20, 24, 45, .22);
}
.dialog-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.dialog-btns { display: flex; margin-top: 32rpx; }
.dialog-btns > view { flex: 1; }
.btn-cancel { text-align: center; padding: 22rpx; color: var(--muted); font-size: 30rpx; }
.btn-confirm { text-align: center; padding: 22rpx; color: var(--brand); font-weight: 600; font-size: 30rpx; }

/* ===== 表单 ===== */
.form-item { margin-bottom: 26rpx; }
.label { display: block; font-size: 26rpx; color: var(--muted); margin-bottom: 12rpx; }
.input {
  background: #F6F8FE; border-radius: var(--radius-sm); padding: 20rpx 24rpx;
  font-size: 30rpx; border: 1rpx solid var(--line);
}
.picker {
  background: #F6F8FE; border-radius: var(--radius-sm); padding: 20rpx 24rpx;
  font-size: 30rpx; border: 1rpx solid var(--line);
}
.tags { display: flex; flex-wrap: wrap; }
.tag {
  padding: 12rpx 28rpx; margin: 0 16rpx 16rpx 0; border-radius: 44rpx;
  font-size: 26rpx; color: var(--ink-2); background: #F2F4FA; border: 1rpx solid transparent;
}
.tag.active { color: var(--brand); background: var(--brand-soft); border-color: rgba(80, 70, 229, .35); font-weight: 600; }

/* ===== 悬浮按钮（页面都在 tabBar 上，留出导航条高度） ===== */
.fab {
  position: fixed; right: 36rpx; bottom: 150rpx; width: 100rpx; height: 100rpx;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%);
  color: #fff; font-size: 56rpx; line-height: 1; z-index: 60;
  box-shadow: 0 14rpx 30rpx rgba(79, 90, 255, .45);
}
.fab:active { transform: scale(.94); }

/* ===== 通用布局 ===== */
.flex { display: flex; align-items: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.gap-sm { margin-right: 12rpx; }
.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }
.list-padding { height: 160rpx; }
