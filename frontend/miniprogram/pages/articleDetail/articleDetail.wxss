/* 文章详情：卡片 / 线性图标 / 九宫格 / 列表行都来自 app.wxss，这里只补本页排版 */
.container { padding: 0 var(--gap) 200rpx; }

/* —— 封面 —— */
.cover {
  width: 100%; height: 380rpx; display: block; margin-top: var(--s-3);
  border-radius: var(--r-md); background: var(--fill); box-shadow: var(--sh-2);
}

/* —— 正文 —— */
.art-card { margin: var(--s-3) 0 0; }
.art-title {
  display: block; font-size: 42rpx; font-weight: 700; color: var(--ink);
  line-height: 1.4; letter-spacing: .3rpx; margin: var(--s-2) 0 var(--s-3);
}
.meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); font-size: 24rpx; color: var(--muted); }
.meta-item { display: flex; align-items: center; gap: 6rpx; }
.content {
  display: block; font-size: 30rpx; line-height: 1.9; color: var(--ink-2);
  white-space: pre-wrap; word-break: break-word;
}

/* —— 操作栏 —— */
.acts { display: flex; gap: var(--s-2); margin: var(--s-3) 0 0; }
.act {
  flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: var(--s-2);
  padding: 22rpx 0; border-radius: var(--r-md); font-size: 28rpx; color: var(--ink-2);
  background: var(--card); border: 1rpx solid var(--line); box-shadow: var(--sh-1);
}
.act:active { transform: scale(.99); }
.act.on { border-color: var(--brand-line); background: var(--brand-soft); color: var(--brand); font-weight: 600; }
.act-num { font-size: 30rpx; font-weight: 700; }
.act-label { font-size: 27rpx; }

/* —— 评论 —— */
.pad-0 { padding: 0; overflow: hidden; }
.cmt-body { display: flex; flex-direction: column; min-width: 0; }
.cmt-user { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.cmt-time { font-size: 22rpx; color: var(--muted); flex: none; }
.cmt-text { display: block; font-size: 28rpx; color: var(--ink-2); margin-top: 6rpx; line-height: 1.65; }

/* —— 底部输入条 —— */
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center; gap: var(--s-2);
  padding: 16rpx var(--gap) 24rpx;
  background: var(--card); border-top: 1rpx solid var(--line);
}
.bar-input {
  flex: 1; min-width: 0; background: var(--fill); border-radius: var(--r-full);
  padding: 18rpx var(--s-4); font-size: 28rpx; color: var(--ink);
}
.bar-send {
  flex: none; display: flex; align-items: center; gap: 4rpx;
  padding: 18rpx 32rpx; border-radius: var(--r-full);
  font-size: 28rpx; font-weight: 600; color: #fff;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  box-shadow: var(--sh-brand);
}
.bar-send:active { opacity: .92; }
