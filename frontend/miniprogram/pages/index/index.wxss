/* 首页：顶部渐变 + 攻略列表 */
.container { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding: 0; }
.refresh-list { flex: 1; height: 0; }
.list-padding { height: 40rpx; }

/* 顶部 */
.hero { position: relative; overflow: hidden; background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%); padding: 24rpx 0 26rpx; border-radius: 0 0 36rpx 36rpx; flex-shrink: 0; }
.hero::after { content: ""; position: absolute; right: -80rpx; top: -110rpx; width: 320rpx; height: 320rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.10); }
.hero::before { content: ""; position: absolute; left: -60rpx; bottom: -130rpx; width: 240rpx; height: 240rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.06); }
.hero-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 32rpx 20rpx; position: relative; }
.hero-title { font-size: 40rpx; font-weight: 800; color: #fff; }
.hero-sub { font-size: 23rpx; color: rgba(255, 255, 255, 0.72); }

.search-bar { position: relative; display: flex; align-items: center; margin: 0 24rpx; padding: 16rpx 26rpx; background: rgba(255, 255, 255, 0.18); border-radius: 44rpx; }
.search-icon { opacity: 0.9; }
.search-bar input { margin-left: 16rpx; flex: 1; font-size: 28rpx; color: #fff; }
.search-ph { color: rgba(255, 255, 255, 0.72); }
.search-clear { width: 40rpx; text-align: center; color: rgba(255, 255, 255, 0.85); font-size: 34rpx; }

.tabs { white-space: nowrap; margin-top: 24rpx; padding: 0 24rpx; position: relative; }
.tab { display: inline-block; padding: 10rpx 30rpx; margin-right: 16rpx; border-radius: 32rpx; font-size: 26rpx; color: rgba(255, 255, 255, 0.85); background: rgba(255, 255, 255, 0.16); }
.tab.active { background: #fff; color: var(--brand); font-weight: 700; }

/* 首条大图 */
.feature { margin: 24rpx 24rpx 8rpx; background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
.feature-cover { width: 100%; height: 320rpx; display: block; }
.feature-fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #EDE9FF 0%, #E1EEFF 100%); color: var(--brand); font-size: 34rpx; font-weight: 700; }
.feature-body { padding: 22rpx 28rpx 26rpx; }
.feature-title { display: block; font-size: 34rpx; font-weight: 700; margin: 14rpx 0 8rpx; line-height: 1.45; }
.feature-body .desc { line-height: 1.55; }
.meta { display: flex; justify-content: space-between; margin-top: 16rpx; font-size: 23rpx; color: var(--muted); }

/* 紧凑列表 */
.article-list { padding: 8rpx 20rpx 0; }
.art-row { display: flex; align-items: stretch; padding: 20rpx; margin: 0 4rpx 18rpx; }
.art-thumb { width: 200rpx; height: 152rpx; border-radius: 18rpx; flex-shrink: 0; }
.art-fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #EDE9FF 0%, #E1EEFF 100%); color: var(--brand); font-size: 26rpx; font-weight: 600; }
.art-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; padding-left: 22rpx; }
.art-title { font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.art-meta { display: flex; align-items: center; justify-content: space-between; }
.chip-sm { font-size: 20rpx; padding: 3rpx 16rpx; }
.list-tip { text-align: center; color: var(--muted); font-size: 23rpx; padding: 10rpx 0 24rpx; }

/* 骨架 */
.sk-card { display: flex; padding: 20rpx; }
.sk-thumb { width: 200rpx; height: 152rpx; border-radius: 18rpx; flex-shrink: 0; }
.sk-lines { flex: 1; padding-left: 22rpx; }
.empty-tip { margin-top: 8rpx; }
