.container { padding-bottom: 20rpx; }
.search-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; }
.search-bar input { margin-left: 12rpx; flex: 1; font-size: 28rpx; }
.tabs { white-space: nowrap; padding: 16rpx 24rpx; background: #fff; }
.tab { display: inline-block; padding: 8rpx 24rpx; margin-right: 16rpx; border-radius: 20rpx; font-size: 26rpx; color: #666; }
.tab.active { background: #4B3FE3; color: #fff; }
.article-list { padding: 0 20rpx; }
.card { display: flex; flex-direction: column; margin-bottom: 20rpx; }
.cover { width: 100%; height: 300rpx; border-radius: 12rpx; }
.article-info { padding: 16rpx 0; }
.title { font-size: 30rpx; font-weight: 600; }
.article-meta { display: flex; justify-content: space-between; margin-top: 8rpx; }
.empty { text-align: center; padding: 100rpx 0; color: #999; }
