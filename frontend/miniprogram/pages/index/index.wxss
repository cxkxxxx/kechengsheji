page {
  /* 页内旧变量名全部指回全局 token，改主题只动 app.wxss */
  --navy: var(--brand);
  --navy-soft: var(--brand-soft);
  --page-bg: var(--bg);
  background: var(--bg);
}

.quick-entries { margin: 0 36rpx 22rpx; }

/* 页面级滚动：不设固定高度、不 overflow hidden，整页随内容自然滚动 */
.container {
  padding: 0 0 20rpx;
  background: var(--page-bg);
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 30rpx 36rpx 20rpx;
  background: #fff;
}
.head-copy { min-width: 0; }
.page-title {
  display: block;
  color: var(--ink);
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.page-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.45;
}
.head-action {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-top: 2rpx;
  border: 1rpx solid #d9e0e8;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}
.head-action:active { background: var(--navy-soft); }
.head-action .ic { opacity: .85; }

/* 搜索框与分类筛选已迁往独立攻略页 pages/articles */
.section-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 30rpx 36rpx 16rpx;
}
.section-title { color: var(--ink); font-size: 30rpx; font-weight: 600; }
.section-count { color: #9aa3ae; font-size: 22rpx; }

.article-card {
  display: flex;
  align-items: stretch;
  min-height: 184rpx;
  margin: 0 24rpx 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: #fff;
  box-shadow: var(--sh-1);
}
.card-tap:active { background: #fafbfd; transform: scale(.995); }
.thumb-wrap { width: 208rpx; height: 156rpx; flex: none; }
.article-thumb {
  display: block;
  width: 208rpx;
  height: 156rpx;
  overflow: hidden;
  border-radius: 10rpx;
}
.thumb-fallback {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx;
  color: #fff;
}
.thumb-fallback::after {
  content: "";
  position: absolute;
  right: -26rpx;
  bottom: -34rpx;
  width: 112rpx;
  height: 112rpx;
  border: 1rpx solid rgba(255,255,255,.27);
  border-radius: 50%;
}
.thumb-0 { background: #536b83; }
.thumb-1 { background: #6b7f78; }
.thumb-2 { background: #7d6f68; }
.thumb-3 { background: #617184; }
.thumb-mark { position: relative; z-index: 1; font-size: 44rpx; line-height: 1; font-weight: 700; }
.thumb-caption { position: relative; z-index: 1; font-size: 21rpx; opacity: .92; }

.article-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: space-between;
  padding: 2rpx 4rpx 0 20rpx;
}
.article-title {
  display: block;
  color: var(--ink);
  font-size: 29rpx;
  line-height: 1.45;
  font-weight: 600;
}
.article-summary {
  display: block;
  margin-top: 7rpx;
  color: #8b95a1;
  font-size: 22rpx;
  line-height: 1.4;
}
.article-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 10rpx; }
.article-author, .article-stats, .stat { display: flex; align-items: center; }
.article-author { min-width: 0; gap: 6rpx; }
.article-author .ic { opacity: .58; }
.author-name { max-width: 102rpx; color: #667282; font-size: 21rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  max-width: 88rpx;
  overflow: hidden;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: var(--navy-soft);
  color: var(--navy);
  font-size: 19rpx;
  line-height: 1.25;
  white-space: nowrap;
}
.article-stats { flex: none; gap: 14rpx; color: #7f8996; font-size: 21rpx; }
.stat { gap: 4rpx; }
.stat .ic { opacity: .63; }
.ic-xs { width: 28rpx; height: 28rpx; background-size: 28rpx 28rpx; }

.skeleton-card { min-height: 184rpx; }
.skeleton { border-radius: 8rpx; background: #edf0f3; }
.skeleton-thumb { width: 208rpx; height: 156rpx; flex: none; }
.skeleton-copy { flex: 1; padding-left: 20rpx; }
.skeleton-title { width: 76%; height: 28rpx; margin: 10rpx 0 22rpx; }
.skeleton-line { width: 94%; height: 20rpx; margin-bottom: 14rpx; }
.skeleton-line.short { width: 48%; }

.list-tip { padding: 8rpx 0 10rpx; color: #a0a8b2; text-align: center; font-size: 21rpx; }

/* 查看全部攻略：首页攻略模块只做精选，完整列表进独立攻略页 */
.all-articles {
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  margin: 6rpx 24rpx 0;
  padding: 22rpx 0;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: #fff;
  color: var(--brand-2); font-size: 26rpx; font-weight: 500;
}
.all-articles .ic { opacity: .6; }
.all-articles:active { background: #fafbfd; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-symbol {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef2f6;
  opacity: .8;
}
.empty-symbol .ic { opacity: .55; }
.empty-text { margin-top: 24rpx; color: var(--ink); font-size: 27rpx; }
.empty-tip { margin-top: 8rpx; color: #98a1ac; font-size: 23rpx; }
.empty-btn { margin-top: 28rpx; padding: 14rpx 28rpx; border: 1rpx solid #cdd6df; border-radius: 10rpx; color: var(--navy); font-size: 24rpx; }
.empty-btn:active { background: var(--navy-soft); }
.list-padding { height: 44rpx; }

/* ---------- 未登录引导 ---------- */
.login-card { display: flex; align-items: center; gap: var(--s-3); margin: 0 36rpx var(--s-3); padding: var(--s-3) var(--s-4); }
.login-card .ic { width: 56rpx; height: 56rpx; background-size: 56rpx 56rpx; opacity: .7; flex: none; }
.login-title { display: block; color: var(--ink); font-size: 28rpx; font-weight: 600; }
.login-sub { display: block; margin-top: 6rpx; color: var(--muted); font-size: 22rpx; }
.login-btn { flex: none; padding: 14rpx 30rpx; font-size: 25rpx; }

/* ---------- 本月省钱概览（含目标，合并一张卡） ---------- */
.ov-card {
  margin: 0 36rpx var(--s-3);
  padding: var(--s-3) var(--s-4) 0;
  background: var(--card);
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
}
.ov-head { display: flex; align-items: center; justify-content: space-between; }
.ov-title { color: var(--ink); font-size: 28rpx; font-weight: 600; }
.ov-month { color: var(--muted); font-size: 22rpx; }
.ov-nums { display: flex; margin-top: var(--s-3); }
.ov-num { flex: 1; min-width: 0; }
.ov-num + .ov-num { border-left: 1rpx solid var(--line); padding-left: var(--s-3); }
.ov-label { display: block; color: var(--muted); font-size: 21rpx; }
.ov-line { display: flex; align-items: baseline; gap: 4rpx; margin-top: 8rpx; }
.ov-val { color: var(--ink); font-size: 36rpx; font-weight: 700; }
.ov-val.pos { color: var(--ok); }
.ov-val.neg { color: var(--danger); }
.ov-val.set { color: var(--brand-2); font-size: 26rpx; font-weight: 500; }
.ov-unit { color: var(--muted); font-size: 20rpx; }
.ov-foot {
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  margin: var(--s-3) calc(-1 * var(--s-4)) 0;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line);
  color: var(--brand-2); font-size: 24rpx;
}
.ov-foot .ic { opacity: .6; }
.ov-foot:active { background: #fafbfd; border-radius: 0 0 var(--r-md) var(--r-md); }

/* 目标区：轻分隔线之后，只显示目标金额、还差和进度，不重复展示「已省」 */
.goal-sec { margin-top: var(--s-3); padding-top: var(--s-3); border-top: 1rpx solid var(--line); }
.goal-nums { display: flex; align-items: center; gap: var(--s-3); }
.goal-num { flex: 1; min-width: 0; }
.goal-num + .goal-num { border-left: 1rpx solid var(--line); padding-left: var(--s-3); }
.goal-label { display: block; color: var(--muted); font-size: 21rpx; }
.goal-val { display: block; margin-top: 8rpx; color: var(--ink); font-size: 32rpx; font-weight: 700; }
.goal-val.pos { color: var(--ok); }
.goal-edit { flex: none; color: var(--brand-2); font-size: 23rpx; }
.goal-edit:active { opacity: .7; }
.goal-bar-wrap { display: flex; align-items: center; gap: var(--s-2); margin-top: var(--s-3); }
.goal-bar { flex: 1; height: 12rpx; border-radius: var(--r-full); background: var(--fill); overflow: hidden; }
.goal-bar-fill { height: 100%; border-radius: var(--r-full); background: var(--ok); transition: width .3s ease; }
.goal-progress { flex: none; color: var(--ink-2); font-size: 22rpx; }
.goal-unset { display: flex; align-items: center; justify-content: space-between; }
.goal-unset-txt { color: var(--muted); font-size: 24rpx; }
.goal-unset-btn { display: flex; align-items: center; gap: 4rpx; color: var(--brand-2); font-size: 24rpx; font-weight: 500; }
.goal-unset-btn:active { opacity: .7; }
.goal-btn { margin-top: var(--s-3); padding: 16rpx 44rpx; font-size: 26rpx; }

/* 日历弹窗里的当天明细列表可滚动（弹窗内，不影响页面级滚动） */
.day-list { max-height: 480rpx; overflow-y: auto; margin: 0 calc(-1 * var(--s-3)); padding: 0 var(--s-3); }

/* ---------- 最近消费 ---------- */
.sec-row { display: flex; align-items: center; justify-content: space-between; margin: 0 36rpx var(--s-2); }
.sec-title { color: var(--ink); font-size: 30rpx; font-weight: 600; }
.sec-act { display: flex; align-items: center; gap: 4rpx; }
.sec-act-txt { color: var(--brand-2); font-size: 23rpx; }
.sec-act .ic { opacity: .55; }
.recent-card { margin: 0 36rpx var(--s-3); }
.rec-row { display: flex; align-items: center; gap: var(--s-2); padding: 22rpx var(--s-3); }
.rec-row + .rec-row { border-top: 1rpx solid var(--line); }
.rec-row:active { background: #FAFAFD; }
.rec-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex: none; }
.rec-main { min-width: 0; }
.rec-note { display: block; color: var(--ink); font-size: 26rpx; }
.rec-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; }
.rec-chip { padding: 2rpx 12rpx; border-radius: var(--r-full); background: var(--fill); color: var(--ink-2); font-size: 20rpx; }
.rec-day { color: var(--muted); font-size: 21rpx; }
.rec-amount { flex: none; color: var(--ink); font-size: 30rpx; font-weight: 700; }
.recent-empty { margin: 0 36rpx var(--s-3); display: flex; flex-direction: column; align-items: center; padding: var(--s-4); }

/* ---------- 弹窗补充 ---------- */
.goal-label-hint { margin-left: 10rpx; font-size: 21rpx; color: var(--muted); font-weight: 400; }
.goal-tip { display: block; margin-top: 8rpx; }
.btn-confirm.disabled, .btn-primary.disabled { opacity: .6; }
