<!-- 首页：省钱攻略列表（首条大图 + 紧凑列表 + 投稿入口） -->
<view class="container">
  <view class="hero">
    <view class="hero-head">
      <view>
        <text class="hero-title">省钱攻略</text>
        <text class="hero-sub">能省一块是一块</text>
      </view>
      <view class="hero-acts">
        <view class="hero-act" bindtap="goAsk"><text class="ic ic-spark ic-sm ic-light"></text></view>
        <view class="hero-act" bindtap="goCreate"><text class="ic ic-plus ic-sm ic-light"></text></view>
      </view>
    </view>
    <view class="search-bar">
      <text class="ic ic-search ic-sm ic-light"></text>
      <input placeholder-class="search-ph" placeholder="搜索攻略标题" value="{{keyword}}"
             bindinput="onSearch" confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" catchtap="clearSearch">
        <text class="ic ic-close ic-sm ic-light"></text>
      </view>
    </view>
    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{categories}}" wx:key="*this"
            class="tab {{currentCategory === item ? 'active' : ''}}"
            bindtap="switchCategory" data-cat="{{item}}">{{item}}</view>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="refresh-list" refresher-enabled
               refresher-triggered="{{refreshing}}"
               bindrefresherrefresh="onRefresherRefresh">
    <block wx:if="{{loading}}">
      <view class="card sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton sk-thumb"></view>
        <view class="sk-lines">
          <view class="skeleton" style="height: 30rpx; width: 70%;"></view>
          <view class="skeleton" style="height: 24rpx; width: 92%; margin-top: 14rpx;"></view>
          <view class="skeleton" style="height: 24rpx; width: 45%; margin-top: 14rpx;"></view>
        </view>
      </view>
    </block>

    <block wx:elif="{{filtered.length}}">
      <view class="feature" bindtap="goDetail" data-id="{{filtered[0].id}}">
        <image wx:if="{{filtered[0].coverUrl}}" class="feature-cover" src="{{filtered[0].coverUrl}}" mode="aspectFill" />
        <view wx:else class="feature-cover feature-fallback"><text>{{filtered[0].category}}</text></view>
        <view class="feature-body">
          <view class="chip">{{filtered[0].category}}</view>
          <text class="feature-title ellipsis-2">{{filtered[0].title}}</text>
          <text class="desc ellipsis-2">{{filtered[0].content}}</text>
          <view class="meta">
            <view class="meta-item"><text class="ic ic-user ic-sm"></text><text>{{filtered[0].author}}</text></view>
            <view class="meta-item">
              <text class="ic {{filtered[0].liked ? 'ic-heart-on' : 'ic-heart'}} ic-sm"></text>
              <text class="num">{{filtered[0].likes}}</text>
              <text class="ic ic-eye ic-sm" style="margin-left:16rpx"></text>
              <text class="num">{{filtered[0].views}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="article-list">
        <view class="card art-row card-tap" wx:for="{{filtered}}" wx:key="id" wx:if="{{index > 0}}"
              bindtap="goDetail" data-id="{{item.id}}">
          <image wx:if="{{item.coverUrl}}" class="art-thumb" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="art-thumb art-fallback"><text>{{item.category}}</text></view>
          <view class="art-info">
            <text class="art-title ellipsis-2">{{item.title}}</text>
            <view class="art-meta">
              <text class="chip chip-sm">{{item.category}}</text>
              <view class="meta-item">
                <text class="ic ic-heart ic-sm"></text><text class="num">{{item.likes}}</text>
                <text class="ic ic-eye ic-sm" style="margin-left:12rpx"></text><text class="num">{{item.views}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="submit-hint" bindtap="goCreate">
        <text class="ic ic-doc"></text>
        <view class="flex-1">
          <text class="submit-hint-t">你有省钱路子？写成攻略</text>
          <text class="submit-hint-d">带张图，通过审核后会上首页</text>
        </view>
        <text class="ic ic-arrow arrow"></text>
      </view>
      <view class="list-tip">下拉看看还没刷到的攻略</view>
    </block>

    <view wx:else class="empty">
      <text class="ic ic-search empty-ic"></text>
      <text class="empty-text">没有匹配的攻略</text>
      <text class="desc empty-tip">换个分类或关键词试试</text>
      <view class="btn-primary empty-btn" bindtap="goCreate">投一篇</view>
    </view>
    <view class="list-padding"></view>
  </scroll-view>
</view>
