/* 帖子详情 */
.post { margin-top: var(--s-3); }
.post-title { font-size: 38rpx; font-weight: 700; line-height: 1.4; display: block; }
.meta { display: flex; align-items: center; gap: var(--s-4); margin: var(--s-3) 0 var(--s-4); }
.meta-item { display: flex; align-items: center; gap: 8rpx; font-size: 23rpx; color: var(--muted); }
.content { font-size: 29rpx; color: var(--ink-2); line-height: 1.75; display: block; white-space: pre-wrap; word-break: break-all; }
.tags { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-4); }

.actions {
  display: flex; margin: 0 var(--gap); padding: var(--s-2) 0;
  background: #fff; border-radius: var(--r-md); box-shadow: var(--sh-1);
}
.action {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 16rpx 0; font-size: 23rpx; color: var(--ink-2);
}
.action:active { background: var(--fill); border-radius: var(--r-sm); }
.action.active { color: var(--brand); }

.comments-section { margin: var(--s-4) var(--gap) 0; }
.section-title-pad { font-size: 28rpx; font-weight: 600; margin-bottom: var(--s-2); }
.comment-item { background: #fff; border-radius: var(--r-sm); padding: var(--s-3); margin-bottom: var(--s-2); }
.comment-user { font-size: 24rpx; color: var(--brand); font-weight: 500; display: block; }
.comment-content { font-size: 27rpx; color: var(--ink-2); display: block; margin: 8rpx 0; line-height: 1.6; }
.comment-time { font-size: 21rpx; color: var(--muted); }

.comment-bar {
  position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid var(--line);
}
.comment-input { flex: 1; height: 76rpx; background: var(--fill); border-radius: var(--r-full); padding: 0 28rpx; font-size: 28rpx; }
.send-btn {
  margin-left: var(--s-2); background: linear-gradient(135deg, var(--brand), var(--brand-2)); color: #fff;
  font-weight: 600; white-space: nowrap; padding: 0 32rpx; height: 76rpx; line-height: 76rpx;
  border-radius: var(--r-full); font-size: 28rpx; box-shadow: var(--sh-brand);
}
