.container { padding: 28rpx; padding-bottom: 140rpx; }
.title { font-size: 40rpx; font-weight: 800; display: block; line-height: 1.4; margin-bottom: 16rpx; }
.meta { display: flex; gap: 24rpx; color: #8A90A6; font-size: 24rpx; margin-bottom: 28rpx; }
.content { font-size: 30rpx; line-height: 1.9; color: #3A4060; display: block; margin-bottom: 24rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { background: linear-gradient(135deg, #EDF0FF 0%, #E8F4FF 100%); color: #5046E5; font-size: 24rpx; padding: 8rpx 22rpx; border-radius: 22rpx; }

/* 操作栏 */
.actions { display: flex; gap: 20rpx; padding: 26rpx 0; border-top: 2rpx solid #EDF1FB; border-bottom: 2rpx solid #EDF1FB; margin: 26rpx 0; }
.action { padding: 16rpx 40rpx; border: 2rpx solid #E4E8F5; border-radius: 44rpx; font-size: 28rpx; color: #5A6078; }
.action.active { background: linear-gradient(135deg, #6D5BFF 0%, #3B82F6 100%); color: #fff; border-color: transparent; box-shadow: 0 8rpx 20rpx rgba(79, 90, 255, 0.3); }

/* 评论区 */
.comments-section { margin-top: 24rpx; }
.section-title { font-size: 32rpx; font-weight: 700; display: block; margin-bottom: 20rpx; }
.comment-item { padding: 22rpx 0; border-bottom: 2rpx solid #EDF1FB; }
.comment-user { font-size: 28rpx; font-weight: 600; color: #5046E5; }
.comment-content { display: block; font-size: 28rpx; color: #3A4060; margin: 8rpx 0; line-height: 1.6; }
.comment-time { font-size: 22rpx; color: #B6BBCD; }
.empty { text-align: center; padding: 40rpx 0; color: #8A90A6; font-size: 26rpx; }

/* 底部评论输入 */
.comment-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx 24rpx; background: #ffffff; border-top: 2rpx solid #EDF1FB; box-shadow: 0 -6rpx 20rpx rgba(37, 63, 183, 0.04); }
.comment-input { flex: 1; background: #F3F6FD; border-radius: 40rpx; padding: 18rpx 30rpx; font-size: 28rpx; }
.send-btn { background: linear-gradient(135deg, #6D5BFF 0%, #3B82F6 100%); color: #fff; font-size: 30rpx; font-weight: 600; padding: 16rpx 34rpx; border-radius: 40rpx; box-shadow: 0 8rpx 20rpx rgba(79, 90, 255, 0.3); }