/* 登录页：只留品牌头区 + 一个主按钮，颜色一律走 app.wxss 的变量 */
.container {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 100vh; padding: 0 var(--s-6) 120rpx; box-sizing: border-box;
  position: relative; overflow: hidden;
  background: #f7f8fa;
}
.glow { position: absolute; border-radius: 50%; pointer-events: none; }
.glow-a {
  right: -150rpx; top: -170rpx; width: 480rpx; height: 480rpx;
  background: transparent;
}
.glow-b {
  left: -150rpx; bottom: -90rpx; width: 420rpx; height: 420rpx;
  background: transparent;
}

.brand { z-index: 1; display: flex; flex-direction: column; align-items: center; }
.logo-badge {
  width: 164rpx; height: 164rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-lg); background: rgba(255, 255, 255, .16);
  border: 2rpx solid rgba(255, 255, 255, .34); color: #fff;
  font-size: 76rpx; font-weight: 700; box-shadow: var(--sh-3); margin-bottom: var(--s-5);
}
.logo { font-size: 62rpx; font-weight: 700; color: #fff; letter-spacing: 6rpx; }
.slogan { font-size: 27rpx; color: rgba(255, 255, 255, .78); letter-spacing: 1rpx; margin-top: var(--s-3); }

/* 主按钮反白，压在渐变上才有层次；渐变底交给 .btn-primary 默认样式的地方用 */
.btn-login {
  z-index: 1; width: 100%; margin-top: 100rpx; padding: 26rpx 44rpx;
  background: var(--card); color: var(--brand);
  border-radius: var(--r-md); font-size: 31rpx; box-shadow: var(--sh-3);
}
.btn-login:active { background: var(--fill); transform: scale(.985); }
.btn-login::after { border: none; }

/* 昵称密码面板：半透明白压在渐变上，比纯白卡片更贴这个背景 */
.panel {
  z-index: 1; width: 100%; margin-top: var(--s-5);
  background: rgba(255, 255, 255, .12);
  border: 1rpx solid rgba(255, 255, 255, .22);
  border-radius: var(--r-lg); padding: var(--s-2);
}
.panel-tabs { display: flex; gap: 6rpx; padding: 6rpx; }
.panel-tab {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--r-sm);
  font-size: 27rpx; color: rgba(255, 255, 255, .8);
}
.panel-tab.active { background: var(--card); color: var(--brand); font-weight: 600; }
.panel-body { padding: var(--s-3) var(--s-2) var(--s-2); }
.field {
  width: 100%; height: 88rpx; margin-bottom: var(--s-3); padding: 0 28rpx;
  box-sizing: border-box; background: rgba(255, 255, 255, .9);
  border-radius: var(--r-sm); font-size: 29rpx; color: var(--ink);
}
.field-ph { color: #9AA1B5; }
.btn-submit {
  height: 88rpx; line-height: 88rpx; text-align: center; border-radius: var(--r-sm);
  background: rgba(255, 255, 255, .18); color: #fff; font-size: 30rpx; font-weight: 600;
  border: 1rpx solid rgba(255, 255, 255, .34);
}
.btn-submit:active { background: rgba(255, 255, 255, .3); }
.panel-tip { display: block; margin-top: var(--s-3); font-size: 21rpx; line-height: 1.6; color: rgba(255, 255, 255, .72); }

page { background: #f7f8fa; }
.container {
  min-height: 100vh;
  padding: 54rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
  justify-content: center;
  background: #f7f8fa;
}
.glow { display: none; }
.brand { margin-bottom: 44rpx; }
.logo-badge {
  width: 112rpx; height: 112rpx; margin-bottom: 22rpx;
  border-radius: 24rpx; border: 0; background: var(--brand); box-shadow: none;
  font-size: 54rpx;
}
.logo { color: #1c2735; font-size: 42rpx; letter-spacing: 2rpx; }
.slogan { margin-top: 8rpx; color: #7a8593; font-size: 24rpx; letter-spacing: 0; }
.btn-login {
  margin-top: 20rpx; padding: 22rpx 32rpx; border: 1rpx solid #dce3e9;
  border-radius: 12rpx; color: var(--brand); box-shadow: none;
}
.panel {
  margin-top: 22rpx; padding: 12rpx; border: 1rpx solid #e7ebef;
  border-radius: 14rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(28,39,53,.05);
}
.panel-tab { color: #7a8593; }
.panel-tab.active { color: var(--brand); background: var(--brand-soft); }
.field { height: 84rpx; border: 1rpx solid #e7ebef; border-radius: 10rpx; background: #f7f8fa; }
.btn-submit { height: 84rpx; line-height: 84rpx; border: 0; border-radius: 10rpx; color: #fff; background: var(--brand); }
.panel-tip { color: #7a8593; }
