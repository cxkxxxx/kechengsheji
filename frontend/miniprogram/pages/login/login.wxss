.container { display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding-top: 240rpx; background: linear-gradient(180deg, #2B1E8F 0%, #4B3FE3 45%, #3B82F6 100%); position: relative; overflow: hidden; box-sizing: border-box; }
.glow { position: absolute; border-radius: 50%; }
.glow-a { right: -140rpx; top: -140rpx; width: 440rpx; height: 440rpx; background: rgba(255,255,255,0.10); }
.glow-b { left: -120rpx; bottom: 60rpx; width: 320rpx; height: 320rpx; background: rgba(255,255,255,0.06); }

.logo-badge { z-index: 1; width: 150rpx; height: 150rpx; line-height: 150rpx; text-align: center; border-radius: 44rpx; background: rgba(255,255,255,0.16); border: 2rpx solid rgba(255,255,255,0.35); color: #fff; font-size: 72rpx; font-weight: 700; box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.25); margin-bottom: 36rpx; }
.logo { z-index: 1; font-size: 64rpx; font-weight: 700; color: #fff; letter-spacing: 6rpx; margin-bottom: 16rpx; }
.desc { z-index: 1; color: rgba(255,255,255,0.82); font-size: 30rpx; }
.btn-primary { z-index: 1; margin-top: 120rpx; width: 76%; background: #ffffff; color: #5046E5; box-shadow: 0 14rpx 44rpx rgba(0,0,0,0.25); }
.btn-primary::after { border: none; }