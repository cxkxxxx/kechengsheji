/* 社区页 */
.refresh-list { height: calc(100vh - 200rpx); }

.comm-post-btn {
  display: flex; align-items: center; gap: 8rpx; flex: none;
  padding: 12rpx 26rpx; border-radius: var(--r-full);
  background: rgba(255, 255, 255, .18); color: #fff; font-size: 26rpx; font-weight: 500;
}
.comm-post-btn:active { background: rgba(255, 255, 255, .32); }

.post-card { padding: var(--s-4); }
.post-top { display: flex; align-items: flex-start; gap: var(--s-2); margin-bottom: 12rpx; }
.post-avatar {
  width: 52rpx; height: 52rpx; border-radius: var(--r-sm); flex: none;
  background: var(--brand-soft); display: flex; align-items: center; justify-content: center;
}
.post-title { font-size: 31rpx; font-weight: 600; color: var(--ink); line-height: 1.45; }
.post-content { font-size: 26rpx; color: var(--ink-2); line-height: 1.6; display: block; }

.post-tags { display: flex; flex-wrap: wrap; gap: var(--s-1); margin-top: var(--s-3); }
.post-meta {
  display: flex; align-items: center; gap: var(--s-4);
  margin-top: var(--s-3); padding-top: var(--s-3); border-top: 1rpx solid var(--line);
}
.meta-item { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--muted); }
.like-btn { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--muted); padding: 4rpx 0; }
.like-btn.liked { color: var(--danger); }
.like-btn:active { opacity: .6; }
.post-time { margin-left: auto; font-size: 22rpx; }

/* 统一为克制的内容社区布局 */
page { background: #f7f8fa; }
.container { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding: 0 0 120rpx; }
.hero { flex: none; padding: 30rpx 36rpx 34rpx; border-radius: 0 0 24rpx 24rpx; }
.hero-title { font-size: 40rpx; }
.hero-sub { font-size: 23rpx; margin-top: 8rpx; }
.comm-post-btn { padding: 12rpx 22rpx; border-radius: 10rpx; background: rgba(255,255,255,.13); border: 1rpx solid rgba(255,255,255,.24); }
.refresh-list { flex: 1; height: 0; padding-top: 18rpx; background: #f7f8fa; }
.post-card { margin: 0 24rpx 16rpx; padding: 22rpx; border: 1rpx solid #edf0f3; border-radius: 14rpx; box-shadow: 0 4rpx 18rpx rgba(28,39,53,.045); }
.post-top { margin-bottom: 14rpx; }
.post-avatar { width: 52rpx; height: 52rpx; border-radius: 12rpx; background: #edf2f6; }
.post-avatar .ic { opacity: .72; }
.post-title { font-size: 30rpx; }
.post-content { color: #536171; font-size: 25rpx; }
.post-meta { margin-top: 18rpx; padding-top: 16rpx; }
.fab { right: 34rpx; bottom: 156rpx; width: 92rpx; height: 92rpx; }
