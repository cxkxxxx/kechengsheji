.container { padding-bottom: 120rpx; }
.post-list { padding: 0 20rpx; }
.card { margin-bottom: 20rpx; }
.title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.desc { display: block; font-size: 26rpx; color: #666; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.post-meta { display: flex; gap: 30rpx; margin-top: 12rpx; }
.fab { position: fixed; right: 40rpx; bottom: 140rpx; width: 90rpx; height: 90rpx; background: #4B3FE3; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 50rpx; box-shadow: 0 4rpx 12rpx rgba(75,63,227,0.3); }
