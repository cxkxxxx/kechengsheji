/* 社区页 */
.container { height: 100vh; display: flex; flex-direction: column; overflow: hidden; padding: 0; }
.refresh-list { flex: 1; height: 0; }
.list-padding { height: 160rpx; }

.comm-head { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 32rpx 22rpx; background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%); border-radius: 0 0 36rpx 36rpx; flex-shrink: 0; }
.comm-title { display: block; font-size: 40rpx; font-weight: 800; color: #fff; }
.comm-sub { display: block; font-size: 23rpx; color: rgba(255, 255, 255, 0.75); margin-top: 4rpx; }
.comm-post-btn { padding: 12rpx 28rpx; background: rgba(255, 255, 255, 0.2); color: #fff; font-size: 26rpx; border-radius: 40rpx; border: 1rpx solid rgba(255, 255, 255, 0.45); }
.comm-post-btn:active { background: rgba(255, 255, 255, 0.32); }

.post-card { padding: 26rpx; margin: 20rpx 24rpx 0; }
.post-top { display: flex; align-items: flex-start; }
.post-avatar { width: 56rpx; height: 56rpx; border-radius: 16rpx; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin-right: 16rpx; flex-shrink: 0; }
.post-title { font-size: 31rpx; font-weight: 700; line-height: 1.45; color: var(--ink); }
.post-content { display: block; font-size: 27rpx; color: var(--ink-2); line-height: 1.6; margin: 14rpx 0 4rpx; }
.ellipsis-3 {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3;
  overflow: hidden; text-overflow: ellipsis;
}
.post-tags { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.chip-sm { font-size: 20rpx; padding: 3rpx 16rpx; margin: 0 12rpx 8rpx 0; }
.post-meta { display: flex; align-items: center; padding-top: 18rpx; margin-top: 14rpx; border-top: 1rpx solid var(--line); }
.like-btn { padding: 6rpx 24rpx; border-radius: 30rpx; font-size: 25rpx; color: var(--ink-2); background: #F3F5FB; margin-right: 24rpx; }
.like-btn.liked { color: #fff; background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%); }
.like-btn:active { transform: scale(0.95); }
.post-time { margin-left: auto; font-size: 22rpx; }
.empty { padding-top: 100rpx; }
.empty-btn { margin-top: 28rpx; padding: 18rpx 64rpx; }
