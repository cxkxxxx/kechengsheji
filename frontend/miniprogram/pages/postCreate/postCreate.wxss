/* 发帖页 */
.pc-head {
  display: flex; align-items: center; gap: var(--s-2);
  padding: 24rpx var(--gap); background: #fff;
}
.pc-head .ic-back { width: 40rpx; height: 40rpx; }
.pc-head-title { font-size: 32rpx; font-weight: 600; }

.pc-title { font-size: 36rpx; font-weight: 600; padding: 8rpx 0; }
.pc-content { width: 100%; min-height: 300rpx; font-size: 29rpx; line-height: 1.7; }
.pc-count { text-align: right; font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }

.pc-foot { padding: var(--s-4) var(--gap) 60rpx; }
.pc-foot button { width: 100%; border: none; }
.pc-foot button::after { border: none; }

page { background: #f7f8fa; }
.pc-head { padding: 20rpx 28rpx; border-bottom: 1rpx solid #e8ecf0; }
.pc-head-title { color: #1c2735; font-size: 30rpx; }
.container > .card { margin: 18rpx 24rpx; padding: 24rpx; border: 1rpx solid #edf0f3; border-radius: 12rpx; box-shadow: 0 4rpx 18rpx rgba(28,39,53,.04); }
.pc-title { font-size: 31rpx; }
.pc-content { min-height: 280rpx; font-size: 27rpx; }
.pc-foot button { border-radius: 10rpx; box-shadow: none; }
.up-add { border-radius: 10rpx; }
