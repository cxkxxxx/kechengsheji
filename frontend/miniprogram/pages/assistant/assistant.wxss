.container { display: flex; flex-direction: column; height: 100vh; }
.chat-list { flex: 1; padding: 20rpx; }
.chat-item { display: flex; flex-direction: column; margin-bottom: 24rpx; }
.chat-item.right { align-items: flex-end; }
.chat-item.left { align-items: flex-start; }
.bubble { max-width: 70%; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; }
.user-bubble { background: #4B3FE3; color: #fff; }
.ai-bubble { background: #fff; color: #171717; }
.tool-tag { font-size: 20rpx; color: #999; margin-top: 6rpx; }
.quick-questions { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 12rpx 20rpx; }
.quick-q { background: #F2F7FF; color: #4B3FE3; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }
.input-bar { display: flex; align-items: center; padding: 16rpx 20rpx; background: #fff; border-top: 1rpx solid #eee; }
.input-bar input { flex: 1; height: 72rpx; background: #f5f5f5; border-radius: 36rpx; padding: 0 24rpx; font-size: 28rpx; }
.send-btn { margin-left: 16rpx; color: #4B3FE3; font-weight: 600; white-space: nowrap; }
