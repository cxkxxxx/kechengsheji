/* AI 助手页：聊天布局、表格与打字指示器 */
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

/* 专家切换条 */
.agent-bar {
  display: flex; align-items: center; gap: var(--s-2); flex-shrink: 0;
  padding: 16rpx 20rpx 12rpx;
  background: #fff;
}
.agent-bar .segment { flex: 1; background: rgba(255, 255, 255, .16); }
.agent-bar .segment-item { color: rgba(255, 255, 255, .88); }
.agent-bar .segment-item.active { color: var(--brand); background: #fff; box-shadow: var(--sh-2); }
.agent-emoji { font-size: 26rpx; margin-right: 8rpx; }
.agent-name { font-size: 27rpx; }
.agent-clear {
  width: 64rpx; height: 64rpx; border-radius: var(--r-sm); flex: none;
  background: rgba(255, 255, 255, .16); display: flex; align-items: center; justify-content: center;
}
.agent-clear:active { background: rgba(255, 255, 255, .3); }
/* 能力入口条：专家切换下面那一行，横向可滚 */
.cap-bar {
  flex-shrink: 0; white-space: nowrap; background: #fff;
  border-bottom: 1rpx solid var(--line); padding: 14rpx 16rpx 16rpx;
}
.cap {
  display: inline-flex; align-items: center;
  padding: 12rpx 22rpx; margin-right: 12rpx; vertical-align: top;
  background: var(--fill); border: 1rpx solid var(--line); border-radius: var(--r-full);
  font-size: 24rpx; color: var(--ink); line-height: 1.2;
  transition: transform .12s ease, background .12s ease;
}
.cap:active { transform: scale(.95); background: var(--brand-soft); border-color: var(--brand-line); }
.cap .ic { width: 26rpx; height: 26rpx; margin-right: 8rpx; }
.cap-dim { opacity: .45; }

/* 聊天区 */
.chat-list { flex: 1; height: 0; padding: var(--s-4) 20rpx 0; }
.chat-bottom-pad { height: var(--s-4); }
.chat-item { display: flex; align-items: flex-start; margin-bottom: 30rpx; }
.chat-item.right { justify-content: flex-end; }
.chat-item.left { justify-content: flex-start; }
.avatar {
  width: 62rpx; height: 62rpx; border-radius: 50%; background: #fff; box-shadow: var(--sh-1);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
  margin-right: 14rpx; flex-shrink: 0;
}
.msg-col { display: flex; flex-direction: column; max-width: 80%; align-items: flex-start; }
.chat-item.right .msg-col { align-items: flex-end; }
.msg-img { width: 260rpx; height: 260rpx; border-radius: var(--r-md); margin-bottom: 10rpx; box-shadow: var(--sh-1); }

/* 表格挂在气泡上方：先看数字，再看结论 */
.msg-tables { width: 100%; margin-bottom: 12rpx; }
.msg-tables .tbl { margin-bottom: 12rpx; }

.bubble { max-width: 100%; padding: 22rpx 26rpx; border-radius: var(--r-md); font-size: 28rpx; line-height: 1.65; word-break: break-all; }
.bubble text { white-space: pre-wrap; }
.ai-bubble { background: #fff; color: var(--ink); border-top-left-radius: 8rpx; box-shadow: var(--sh-1); }
.user-bubble { background: var(--brand); color: #fff; border-top-right-radius: 8rpx; box-shadow: none; }
.tool-tag { font-size: 20rpx; color: var(--muted); margin-top: 8rpx; padding: 2rpx 14rpx; background: var(--fill); border-radius: var(--r-full); }

/* 比价购买入口卡片 */
.link-cards { width: 100%; margin-top: 14rpx; }
.link-card {
  display: flex; align-items: center; width: 100%; box-sizing: border-box;
  padding: 18rpx 22rpx; margin-bottom: 12rpx; border-radius: var(--r-sm);
  background: #fff; border: 1rpx solid var(--line); box-shadow: var(--sh-1);
}
.link-card:active { background: var(--brand-soft); transform: scale(.99); }
.lc-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.lc-platform { font-size: 22rpx; color: var(--brand); font-weight: 600; }
.lc-label { font-size: 24rpx; color: var(--ink-2); margin-top: 2rpx; }
.lc-price { font-size: 30rpx; font-weight: 600; color: var(--danger); margin: 0 16rpx; }
.lc-copy {
  display: flex; align-items: center; gap: 4rpx; font-size: 22rpx; color: var(--brand);
  border: 1rpx solid var(--brand-line); padding: 8rpx 20rpx; border-radius: var(--r-full); flex-shrink: 0;
}
.lc-tip { display: block; font-size: 21rpx; color: var(--muted); padding: 2rpx 6rpx; }

/* 等待中的打字点 */
.thinking { display: flex; align-items: center; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #C3C8DA; margin-right: 8rpx; animation: blink 1.2s infinite ease-in-out; }
.dot:nth-child(2) { animation-delay: .18s; }
.dot:nth-child(3) { animation-delay: .36s; margin-right: 16rpx; }
@keyframes blink { 0%, 80%, 100% { opacity: .35; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-6rpx); } }
.thinking-text { font-size: 24rpx; color: var(--muted); }

/* 开场引导 */
.welcome { padding: 56rpx 20rpx 20rpx; text-align: center; }
.welcome-emoji { display: block; font-size: 70rpx; }
.welcome-title { display: block; font-size: 34rpx; font-weight: 700; margin: 14rpx 0 6rpx; letter-spacing: .5rpx; }
.welcome-desc { display: block; font-size: 25rpx; color: var(--muted); margin-bottom: 26rpx; line-height: 1.6; }
.welcome-qs { display: flex; flex-wrap: wrap; justify-content: center; }
.welcome-q { background: #fff; color: var(--brand); font-size: 26rpx; padding: 16rpx 26rpx; border-radius: var(--r-full); margin: 0 10rpx 16rpx; box-shadow: var(--sh-1); border: 1rpx solid var(--line); }
.welcome-q:active { background: var(--brand-soft); }

/* 快捷问题条 */
.quick-bar { white-space: nowrap; padding: 10rpx 20rpx 14rpx; flex-shrink: 0; }
.quick-q { display: inline-block; background: #fff; color: var(--brand); font-size: 24rpx; padding: 10rpx 22rpx; border-radius: var(--r-full); margin-right: 14rpx; border: 1rpx solid var(--line); }
.quick-q:active { background: var(--brand-soft); }

/* 输入区 */
.input-area { background: #fff; border-top: 1rpx solid var(--line); padding-bottom: env(safe-area-inset-bottom); flex-shrink: 0; }
.img-preview { position: relative; width: 120rpx; height: 120rpx; margin: 16rpx 0 0 20rpx; }
.img-preview-img { width: 120rpx; height: 120rpx; border-radius: var(--r-sm); }
.img-remove {
  position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;
  background: rgba(19, 23, 40, .6); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.img-remove .ic { width: 24rpx; height: 24rpx; background-size: 24rpx 24rpx; filter: brightness(0) invert(1); }
.input-bar { display: flex; align-items: center; padding: 16rpx 20rpx; }
.input-bar input { flex: 1; min-width: 0; height: 76rpx; background: var(--fill); border-radius: var(--r-full); padding: 0 28rpx; font-size: 28rpx; margin: 0 16rpx; }
.ph { color: #A6ACBE; }
.img-btn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.img-btn.busy { opacity: .5; }
.send-btn {
  background: var(--brand); color: #fff;
  font-weight: 600; white-space: nowrap; padding: 0 32rpx; height: 76rpx; line-height: 76rpx;
  border-radius: var(--r-full); font-size: 28rpx; flex-shrink: 0; box-shadow: var(--sh-brand);
}
.send-btn.busy { opacity: .75; }

/* 对话工具页：信息优先，保持与首页一致的藏蓝中性灰体系 */
page { background: #f7f8fa; }
.page { background: #f7f8fa; }
.agent-bar { padding: 16rpx 24rpx 12rpx; background: #fff; border-bottom: 1rpx solid #e8ecf0; }
.agent-bar .segment { background: #f0f3f6; }
.agent-bar .segment-item { color: #6b7685; }
.agent-bar .segment-item.active { color: #fff; background: #263b55; box-shadow: none; }
.agent-clear { background: #f0f3f6; }
.agent-clear:active { background: #e3e9ef; }
.cap-bar { padding: 12rpx 24rpx 14rpx; background: #fff; border-bottom: 1rpx solid #e8ecf0; }
.cap { background: #f0f3f6; border-color: #f0f3f6; color: #4a5666; }
.cap:active { background: #e9eff4; border-color: #cfdbe6; color: #263b55; }
.chat-list { padding: 28rpx 24rpx 0; }
.avatar { width: 58rpx; height: 58rpx; margin-right: 14rpx; border-radius: 14rpx; background: #e9eff4; box-shadow: none; }
.avatar-mark { color: #263b55; font-size: 26rpx; font-weight: 700; }
.bubble { border-radius: 12rpx; font-size: 27rpx; }
.ai-bubble { border: 1rpx solid #e8ecf0; box-shadow: none; }
.user-bubble { background: #263b55; box-shadow: none; }
.welcome { padding: 52rpx 24rpx 20rpx; }
.welcome-symbol { width: 86rpx; height: 86rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #e9eff4; }
.welcome-symbol .ic { opacity: .8; }
.welcome-title { font-size: 32rpx; }
.welcome-q { border-radius: 10rpx; color: #263b55; box-shadow: none; padding: 14rpx 22rpx; }
.quick-q { border-radius: 10rpx; color: #263b55; }
.input-area { background: #fff; }
.img-btn { border-radius: 12rpx; background: #edf2f6; }
.send-btn { background: #263b55; border-radius: 10rpx; box-shadow: none; padding: 0 26rpx; }
.link-card { box-shadow: none; border-radius: 10rpx; }
.lc-copy { border-radius: 8rpx; color: #263b55; border-color: #cbd5df; }
