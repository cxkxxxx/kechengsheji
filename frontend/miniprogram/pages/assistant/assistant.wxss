/* AI 助手页：按参考图还原的工作区
   标题 → AI 欢迎卡 → 模式切换 → 常用功能 → 你可以这样问 → 对话 → 输入条
   样式只定义一层，全部引用 app.wxss 的 token */
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: var(--bg); }

/* —— 标题栏（自定义导航，避开右上角胶囊） —— */
.page-head {
  display: flex; align-items: flex-end; flex-shrink: 0;
  padding-left: 32rpx; padding-bottom: 12rpx;
  background: var(--card); border-bottom: 1rpx solid var(--line);
}
.page-title { font-size: 40rpx; font-weight: 700; color: var(--ink); letter-spacing: .5rpx; line-height: 1.2; }

/* —— 聊天态顶部条：紧凑模式切换 + 清空 —— */
.top-bar {
  display: flex; align-items: center; gap: var(--s-2); flex-shrink: 0;
  padding: 12rpx 24rpx; background: var(--card); border-bottom: 1rpx solid var(--line);
}
.mode-mini { display: flex; gap: 8rpx; flex: 1; min-width: 0; }
.mode-mini-item {
  display: flex; align-items: center; gap: 6rpx;
  padding: 8rpx 20rpx; border-radius: var(--r-full);
  background: var(--fill); color: var(--ink-2); font-size: 24rpx;
}
.mode-mini-item.on { background: var(--brand); color: #fff; font-weight: 600; }
.mode-mini-item .ic { width: 26rpx; height: 26rpx; background-size: 26rpx 26rpx; }
.mode-mini-txt { white-space: nowrap; }
.agent-clear {
  width: 56rpx; height: 56rpx; border-radius: var(--r-sm); flex: none;
  background: var(--fill); display: flex; align-items: center; justify-content: center;
}
.agent-clear:active { background: var(--line); }

/* —— 聊天区 —— */
.chat-list { flex: 1; height: 0; padding: 24rpx 24rpx 0; }
.chat-bottom-pad { height: var(--s-4); }
.chat-item { display: flex; align-items: flex-start; margin-bottom: 30rpx; }
.chat-item.right { justify-content: flex-end; }
.chat-item.left { justify-content: flex-start; }
.avatar {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 2rpx;
}
.ai-avatar { background: var(--ai); margin-right: 14rpx; }
.avatar-ai { color: #fff; font-size: 21rpx; font-weight: 700; letter-spacing: .5rpx; }
.user-avatar { background: var(--fill); margin-left: 14rpx; }
.user-avatar .ic { width: 28rpx; height: 28rpx; background-size: 28rpx 28rpx; opacity: .75; }
.msg-col { display: flex; flex-direction: column; max-width: 80%; align-items: flex-start; }
.chat-item.right .msg-col { align-items: flex-end; }
.msg-img { width: 260rpx; height: 260rpx; border-radius: var(--r-md); margin-bottom: 10rpx; box-shadow: var(--sh-1); }

/* 表格跟在答案后面：先给结论，再给可细看的数字 */
.msg-tables { width: 100%; margin-top: 12rpx; }
.msg-tables .tbl { margin-bottom: 12rpx; }

/* —— 气泡 —— */
.bubble { max-width: 100%; padding: 22rpx 26rpx; border-radius: var(--r-sm); font-size: 27rpx; line-height: 1.65; word-break: break-all; }
.bubble text { white-space: pre-wrap; }
/* AI 正文不包大白卡：透明底直接排在页面上，长回答读起来是文章不是弹窗；
   表格、商品卡等结构化数据仍然是独立卡片 */
.ai-bubble { background: transparent; color: var(--ink); border: none; padding: 4rpx 6rpx; }
.ai-bubble.is-error {
  background: rgba(223, 81, 81, .05); border: 1rpx solid rgba(223, 81, 81, .35);
  color: var(--danger); padding: 22rpx 26rpx; border-top-left-radius: 6rpx;
}
/* 等待/生成中的占位保留浅卡，一眼知道这里是 AI 的输出区 */
.ai-bubble.is-thinking { background: var(--card); border: 1rpx solid var(--line); padding: 22rpx 26rpx; }
/* 用户气泡：浅蓝灰背景，靠右 */
.user-bubble { background: #E7EDF6; color: var(--ink); font-weight: 500; border-top-right-radius: 6rpx; }
.user-img-only { color: var(--ink-2); font-weight: 400; font-size: 24rpx; }

/* —— Markdown 正文：标题/段落/列表/加粗，源标记不落到页面上 —— */
.md text { white-space: pre-wrap; }
.md-h { color: var(--ink); font-weight: 700; margin: 10rpx 0 4rpx; line-height: 1.45; }
.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 31rpx; }
.md-h3 { font-size: 29rpx; }
.md-h4, .md-h5, .md-h6 { font-size: 27rpx; }
.md-p { margin: 6rpx 0; }
.md-ul, .md-ol { margin: 6rpx 0; }
.md-li { display: flex; align-items: flex-start; margin: 4rpx 0; }
.md-bullet { flex: none; width: 28rpx; color: var(--ai); font-weight: 700; }
.md-num { flex: none; width: 34rpx; color: var(--ai); font-weight: 600; font-variant-numeric: tabular-nums; }
.md-li-txt { flex: 1; min-width: 0; }
.md-b { font-weight: 700; color: var(--ink); }
.md-code { background: var(--fill); padding: 2rpx 8rpx; border-radius: var(--r-xs); font-family: Menlo, Consolas, monospace; }
.md-quote { border-left: 4rpx solid var(--ai-line); padding-left: 16rpx; margin: 8rpx 0; color: var(--ink-2); }
.md-hr { height: 1rpx; background: var(--line); margin: 14rpx 0; }

/* 生成中脚注：正文还在长的时候挂在气泡底部 */
.gen-hint { display: flex; align-items: center; margin-top: 10rpx; font-size: 20rpx; color: var(--muted); }
.dot-sm { width: 8rpx; height: 8rpx; margin-right: 6rpx; }

/* 失败重试：红边气泡下方的一个明确出口 */
.retry-row {
  display: inline-flex; align-items: center; gap: 6rpx; margin-top: 10rpx;
  padding: 12rpx 24rpx; border-radius: var(--r-full);
  background: rgba(223, 81, 81, .07); border: 1rpx solid rgba(223, 81, 81, .3);
  color: var(--danger); font-size: 24rpx; font-weight: 500;
}
.retry-row:active { background: rgba(223, 81, 81, .14); }
.retry-row .ic { width: 24rpx; height: 24rpx; background-size: 24rpx 24rpx; }

/* 无结果 / 数据不完整：诚实状态卡，不用假正文撑场面 */
.none-box {
  background: var(--card); border: 1rpx dashed var(--line); border-radius: var(--r-sm);
  padding: 22rpx 26rpx; max-width: 100%;
}
.none-box.is-partial { border-color: rgba(176, 123, 36, .4); background: rgba(176, 123, 36, .04); }
.none-title { display: block; font-size: 25rpx; color: var(--ink-2); font-weight: 500; }
.none-sub { display: block; font-size: 22rpx; color: var(--muted); margin-top: 6rpx; line-height: 1.5; }

.canceled-tag {
  display: inline-flex; align-items: center; margin-top: 8rpx;
  padding: 4rpx 16rpx; border-radius: var(--r-full);
  background: var(--fill); color: var(--muted); font-size: 21rpx;
}

/* —— 比价总结条：只用实时报价算结论，放在商品列表顶部 —— */
.price-sum {
  padding: 18rpx 22rpx; margin-bottom: 12rpx;
  background: var(--ai-soft); border-radius: var(--r-sm);
}
.ps-name { display: block; font-size: 24rpx; color: var(--ink-2); }
.ps-low { display: block; font-size: 34rpx; font-weight: 700; color: var(--ai-deep); margin-top: 6rpx; }
.ps-spread { display: block; font-size: 22rpx; font-weight: 600; color: #0E7A55; margin-top: 4rpx; }
.ps-src { display: block; margin-top: 4rpx; font-size: 20rpx; color: var(--muted); }

/* —— 比价结果卡（纵向）：商品 → 商家 → 价格 → 说明 → 操作 —— */
.link-cards { width: 100%; margin-top: 14rpx; }
.link-card {
  width: 100%; box-sizing: border-box;
  padding: 22rpx 24rpx; margin-bottom: 12rpx; border-radius: var(--r-sm);
  background: var(--card); border: 1rpx solid var(--line);
}
.link-card.is-lowest { border-color: rgba(24, 167, 117, .45); background: rgba(24, 167, 117, .04); }
.lc-head { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.lc-platform { font-size: 24rpx; color: var(--ink); font-weight: 600; flex: none; }
.lc-badge {
  flex: none; font-size: 19rpx; font-weight: 600; color: #0E7A55;
  background: rgba(24, 167, 117, .12); padding: 2rpx 10rpx; border-radius: var(--r-full);
}
.lc-src { font-size: 20rpx; color: var(--muted); margin-left: auto; flex: none; }
.lc-desc { display: block; font-size: 26rpx; color: var(--ink); margin-top: 10rpx; line-height: 1.5; }
.lc-shop { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; min-width: 0; }
.lc-shop-label { flex: none; font-size: 20rpx; color: var(--muted); background: var(--fill); padding: 2rpx 10rpx; border-radius: var(--r-xs); }
.lc-shop-val { font-size: 22rpx; color: var(--ink-2); min-width: 0; }
.lc-price-row { display: flex; align-items: baseline; gap: 14rpx; margin-top: 12rpx; }
.lc-price { font-size: 40rpx; font-weight: 700; color: var(--ink); line-height: 1.2; }
.link-card.is-lowest .lc-price { color: #0E7A55; }
.lc-price-none { font-size: 26rpx; color: var(--muted); }
.lc-cut { flex: none; font-size: 22rpx; font-weight: 600; color: #0E7A55; }
.lc-meta { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; font-size: 20rpx; color: var(--muted); }
.lc-open {
  margin-top: 16rpx; text-align: center;
  font-size: 24rpx; font-weight: 600; color: var(--brand);
  background: var(--brand-soft); padding: 16rpx 0; border-radius: var(--r-sm);
}
.lc-open:active { opacity: .85; }

/* 一步动作条：答案下面的「接着干」入口 */
.msg-acts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.act-chip {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 12rpx 22rpx; border-radius: var(--r-full);
  background: var(--ai-soft); border: 1rpx solid var(--ai-line);
  color: var(--ai-deep); font-size: 24rpx; font-weight: 500;
}
.act-chip:active { opacity: .75; }
.act-chip .ic { width: 26rpx; height: 26rpx; }

/* 等待中的打字点 */
.thinking { display: flex; align-items: center; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #C3C8DA; margin-right: 8rpx; animation: blink 1.2s infinite ease-in-out; }
.dot:nth-child(2) { animation-delay: .18s; }
.dot:nth-child(3) { animation-delay: .36s; margin-right: 16rpx; }
@keyframes blink { 0%, 80%, 100% { opacity: .35; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-6rpx); } }
.thinking-text { font-size: 24rpx; color: var(--muted); }

/* —— 初始态：AI 欢迎卡 —— */
.home { padding-bottom: 8rpx; }
.ai-card {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--ai-soft); border: 1rpx solid var(--ai-line);
  border-radius: 20rpx; padding: 26rpx 24rpx; margin-top: 8rpx;
}
.ai-card-ic { flex: none; }
.ai-card-ic .ic { width: 84rpx; height: 84rpx; background-size: 84rpx 84rpx; }
.ai-card-txt { flex: 1; min-width: 0; }
.ai-card-hi { display: block; font-size: 32rpx; font-weight: 700; color: var(--ink); line-height: 1.4; }
.ai-card-role { display: block; font-size: 26rpx; font-weight: 600; color: var(--ai-deep); margin-top: 6rpx; }
.ai-card-desc { display: block; font-size: 22rpx; color: var(--muted); margin-top: 6rpx; line-height: 1.55; }

/* —— 模式切换（分段） —— */
.mode-bar {
  display: flex; gap: 8rpx; margin-top: 24rpx;
  background: var(--fill); border-radius: var(--r-sm); padding: 6rpx;
}
.mode-item {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 16rpx 0; border-radius: 12rpx;
  font-size: 27rpx; color: var(--ink-2); transition: all .18s ease;
}
.mode-item.on { background: var(--brand); color: #fff; font-weight: 600; box-shadow: var(--sh-1); }
.mode-item .ic { width: 30rpx; height: 30rpx; background-size: 30rpx 30rpx; }

/* —— 区块标题（常用功能 / 你可以这样问） —— */
.sec-row { display: flex; align-items: center; justify-content: space-between; margin: 32rpx 0 16rpx; }
.sec-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.sec-act { padding: 6rpx 4rpx; }
.sec-act-txt { font-size: 23rpx; color: var(--ai); }

/* 2×2 功能卡：图标 + 标题 + 一行说明 + 右向箭头 */
.feature-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.feature-card {
  width: calc(50% - 8rpx); box-sizing: border-box;
  display: flex; align-items: center; gap: 12rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: var(--r-sm);
  padding: 20rpx 14rpx 20rpx 16rpx; box-shadow: var(--sh-1);
  transition: transform .14s ease;
}
.feature-card:active { transform: scale(.97); background: var(--ai-soft); }
.feature-ic {
  width: 60rpx; height: 60rpx; flex: none; border-radius: 14rpx;
  background: var(--ai-soft); display: flex; align-items: center; justify-content: center;
}
.feature-ic .ic { width: 32rpx; height: 32rpx; background-size: 32rpx 32rpx; }
.feature-txt { flex: 1; min-width: 0; }
.feature-name { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink); }
.feature-desc { display: block; font-size: 20rpx; color: var(--muted); margin-top: 4rpx; line-height: 1.35; }
.feature-arrow { flex: none; width: 24rpx; height: 24rpx; background-size: 24rpx 24rpx; opacity: .6; }

/* 你可以这样问：白底描边问句签 */
.ask-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ask-tag {
  background: var(--card); border: 1rpx solid var(--line); color: var(--ink-2);
  font-size: 24rpx; padding: 14rpx 22rpx; border-radius: var(--r-sm); line-height: 1.4;
}
.ask-tag:active { background: var(--ai-soft); border-color: var(--ai-line); color: var(--ai-deep); }

/* —— 聊天态的紧凑常用功能条 —— */
.cap-strip { flex-shrink: 0; border-top: 1rpx solid var(--line); background: var(--card); padding: 12rpx 0; }
.cap-bar { white-space: nowrap; padding: 0 24rpx; }
.cap {
  display: inline-flex; align-items: center;
  padding: 12rpx 22rpx; margin-right: 12rpx; vertical-align: top;
  background: var(--card); border: 1rpx solid var(--line); border-radius: var(--r-sm);
  font-size: 24rpx; color: var(--ink-2); line-height: 1.2;
  transition: transform .12s ease, background .12s ease;
}
.cap:active { transform: scale(.95); background: var(--ai-soft); border-color: var(--ai-line); color: var(--ai-deep); }
.cap .ic { width: 26rpx; height: 26rpx; margin-right: 8rpx; }
.cap-dim { opacity: .45; }

/* —— 输入区：圆角容器 + 相机 + 主色发送键，textarea 自适应 —— */
.input-area { background: var(--bg); padding: 14rpx 24rpx; padding-bottom: calc(14rpx + env(safe-area-inset-bottom)); flex-shrink: 0; }
.img-preview { position: relative; width: 120rpx; height: 120rpx; margin: 0 0 12rpx 4rpx; }
.img-preview-img { width: 120rpx; height: 120rpx; border-radius: var(--r-sm); }
.img-remove {
  position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;
  background: rgba(19, 23, 40, .6); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.img-remove .ic { width: 24rpx; height: 24rpx; background-size: 24rpx 24rpx; filter: brightness(0) invert(1); }
.input-bar {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 32rpx;
  padding: 10rpx 10rpx 10rpx 12rpx; box-shadow: var(--sh-1);
}
.input-ta {
  flex: 1; min-height: 56rpx; max-height: 240rpx;
  font-size: 27rpx; line-height: 1.5; color: var(--ink);
  padding: 10rpx 0; width: 100%;
}
.ph { color: #A6ACBE; }
.img-btn {
  width: 64rpx; height: 64rpx; border-radius: 14rpx; flex: none;
  background: var(--fill); display: flex; align-items: center; justify-content: center;
}
.img-btn .ic { width: 32rpx; height: 32rpx; background-size: 32rpx 32rpx; }
.img-btn.busy { opacity: .5; }
.send-btn {
  width: 68rpx; height: 68rpx; border-radius: 18rpx; flex: none;
  background: var(--brand);
  display: flex; align-items: center; justify-content: center;
}
.send-btn .ic { width: 34rpx; height: 34rpx; background-size: 34rpx 34rpx; }
.send-btn.busy { opacity: .75; }
