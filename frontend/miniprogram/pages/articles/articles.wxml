<view class="container">
  <view class="page-head">
    <view class="head-copy">
      <text class="page-title">省钱攻略</text>
      <text class="page-subtitle">搜索、分类浏览全部攻略</text>
    </view>
    <view class="head-action" bindtap="goCreate" aria-label="发布攻略">
      <text class="ic ic-plus ic-sm"></text>
    </view>
  </view>

  <view class="search-bar">
    <text class="ic ic-search ic-sm"></text>
    <input class="search-input" placeholder-class="search-ph" placeholder="搜索攻略标题或关键词"
           value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <view class="search-clear" wx:if="{{keyword}}" catchtap="clearSearch">
      <text class="ic ic-close ic-sm"></text>
    </view>
  </view>

  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{categories}}" wx:key="*this"
          class="tab {{currentCategory === item ? 'active' : ''}}"
          bindtap="switchCategory" data-cat="{{item}}">{{item}}</view>
  </scroll-view>

  <view class="section-bar">
    <text class="section-title">{{currentCategory === '全部' ? '全部攻略' : currentCategory + '攻略'}}</text>
    <text class="section-count" wx:if="{{!loading}}">{{filtered.length}} 条内容</text>
  </view>

  <block wx:if="{{loading}}">
    <view class="article-card skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="skeleton skeleton-thumb"></view>
      <view class="skeleton-copy">
        <view class="skeleton skeleton-title"></view>
        <view class="skeleton skeleton-line"></view>
        <view class="skeleton skeleton-line short"></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{filtered.length}}">
    <view class="article-card card-tap" wx:for="{{filtered}}" wx:key="id"
          bindtap="goDetail" data-id="{{item.id}}">
      <view class="thumb-wrap">
        <image wx:if="{{item.coverUrl}}" class="article-thumb" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="article-thumb thumb-fallback thumb-{{index % 4}}">
          <text class="thumb-mark">省</text>
          <text class="thumb-caption">{{item.category}}</text>
        </view>
      </view>
      <view class="article-info">
        <text class="article-title ellipsis-2">{{item.title}}</text>
        <text class="article-summary ellipsis">{{item.content}}</text>
        <view class="article-bottom">
          <view class="article-author">
            <text class="ic ic-user ic-xs"></text>
            <text class="author-name ellipsis">{{item.author || '省钱达人'}}</text>
            <text class="chip chip-sm">{{item.category}}</text>
          </view>
          <view class="article-stats">
            <view class="stat fav-btn" catchtap="toggleFav" data-id="{{item.id}}">
              <text class="ic {{item.liked ? 'ic-heart-on' : 'ic-heart'}} ic-xs"></text>
            </view>
            <view class="stat"><text class="ic ic-eye ic-xs"></text><text>{{item.views || 0}}</text></view>
          </view>
        </view>
      </view>
    </view>
    <view class="list-tip">共 {{filtered.length}} 条 · 下拉刷新</view>
  </block>

  <view wx:else class="empty">
    <view class="empty-symbol"><text class="ic ic-search"></text></view>
    <text class="empty-text">暂时没有匹配的攻略</text>
    <text class="empty-tip">换个分类或关键词试试看</text>
    <view class="empty-btn" bindtap="clearSearch">清除筛选</view>
  </view>
  <view class="list-padding"></view>
</view>
