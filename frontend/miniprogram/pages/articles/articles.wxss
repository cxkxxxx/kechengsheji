page {
  --navy: var(--brand);
  --navy-soft: var(--brand-soft);
  --page-bg: var(--bg);
  background: var(--bg);
}

.container {
  padding: 0 0 40rpx;
  background: var(--page-bg);
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 30rpx 36rpx 20rpx;
  background: #fff;
}
.head-copy { min-width: 0; }
.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  letter-spacing: -0.5rpx;
}
.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}
.head-action {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  color: var(--ink-2);
  flex: none;
}
.head-action:active { background: var(--navy-soft); }
.head-action .ic { opacity: .85; }

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 36rpx 22rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--r-full);
}
.search-bar .ic { opacity: .72; }
.search-input { flex: 1; min-width: 0; font-size: 26rpx; color: var(--ink); }
.search-ph { color: #a0a9b4; }
.search-clear {
  width: 44rpx; height: 44rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--fill);
  border-radius: 50%;
  flex: none;
}
.search-clear .ic { opacity: .5; }

.tabs {
  white-space: nowrap;
  padding: 0 36rpx 8rpx;
}
.tab {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: var(--r-full);
}
.tab.active {
  border-color: var(--navy);
  color: #fff;
  background: var(--navy);
  font-weight: 600;
}

.section-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 36rpx 16rpx;
}
.section-title { color: var(--ink); font-size: 30rpx; font-weight: 600; }
.section-count { color: #9aa3ae; font-size: 22rpx; }

.article-card {
  display: flex;
  gap: 20rpx;
  margin: 0 36rpx 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
}
.card-tap { transition: transform .16s ease, box-shadow .16s ease; }
.card-tap:active { transform: scale(.988); box-shadow: var(--sh-2); }
.thumb-wrap { width: 208rpx; height: 156rpx; flex: none; }
.article-thumb {
  width: 100%; height: 100%;
  border-radius: var(--r-sm);
  background: var(--fill);
}
.thumb-fallback {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 6rpx;
  color: #fff;
}
.thumb-fallback::after {
  content: '';
  position: absolute;
  width: 208rpx; height: 156rpx;
  border-radius: var(--r-sm);
  background: linear-gradient(135deg, rgba(255,255,255,.14), transparent 55%);
}
.thumb-0 { background: #536b83; }
.thumb-1 { background: #6b7f78; }
.thumb-2 { background: #7d6f68; }
.thumb-3 { background: #617184; }
.thumb-mark { position: relative; z-index: 1; font-size: 44rpx; line-height: 1; font-weight: 700; }
.thumb-caption { position: relative; z-index: 1; font-size: 21rpx; opacity: .92; }

.article-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.article-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.article-summary {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}
.article-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 10rpx; }
.article-author, .article-stats, .stat { display: flex; align-items: center; }
.article-author { min-width: 0; gap: 6rpx; }
.article-author .ic { opacity: .58; }
.author-name { max-width: 102rpx; color: #667282; font-size: 21rpx; }
.article-stats { flex: none; gap: 14rpx; color: #7f8996; font-size: 21rpx; }
.stat { gap: 4rpx; }
.stat .ic { opacity: .63; }
.fav-btn { padding: 8rpx; margin: -8rpx; }
.fav-btn:active { opacity: .6; }

.ic-xs { width: 28rpx; height: 28rpx; background-size: 28rpx 28rpx; }

.skeleton-card { min-height: 184rpx; }
.skeleton { border-radius: 8rpx; background: #edf0f3; }
.skeleton-thumb { width: 208rpx; height: 156rpx; flex: none; }
.skeleton-copy { flex: 1; padding-left: 20rpx; }
.skeleton-title { width: 76%; height: 28rpx; margin: 10rpx 0 22rpx; }
.skeleton-line { width: 94%; height: 20rpx; margin-bottom: 14rpx; }
.skeleton-line.short { width: 48%; }

.list-tip { padding: 8rpx 0 26rpx; color: #a0a8b2; text-align: center; font-size: 21rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-symbol {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef2f6;
  opacity: .8;
}
.empty-symbol .ic { opacity: .55; }
.empty-text { margin-top: 24rpx; color: var(--ink); font-size: 27rpx; }
.empty-tip { margin-top: 8rpx; color: #98a1ac; font-size: 23rpx; }
.empty-btn { margin-top: 28rpx; padding: 14rpx 28rpx; border: 1rpx solid #cdd6df; border-radius: 10rpx; color: var(--navy); font-size: 24rpx; }
.empty-btn:active { background: var(--navy-soft); }
.list-padding { height: 44rpx; }
