/* 我的：通用件（hero / list-row / card / chip / ic）在 app.wxss */
.container { padding-bottom: var(--s-6); }

/* —— 头区 —— */
.hero { padding-bottom: var(--s-4); }
.avatar {
  width: 108rpx; height: 108rpx; border-radius: 50%; flex: none;
  background: rgba(255, 255, 255, .18); border: 3rpx solid rgba(255, 255, 255, .5);
  box-shadow: var(--sh-2);
}
.user-text { margin-left: var(--s-3); min-width: 0; }
.hero-sub { color: rgba(255, 255, 255, .8); opacity: 1; }

/* —— 概览三格 —— */
.stat-row { display: flex; gap: var(--s-2); margin-top: var(--s-5); }
.stat {
  flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-height: 136rpx; padding: var(--s-3) var(--s-1); border-radius: var(--r-sm);
  background: rgba(255, 255, 255, .13); transition: background .16s ease;
}
.stat:active { background: rgba(255, 255, 255, .24); }
.stat-num { font-size: 40rpx; font-weight: 700; color: #fff; line-height: 1.2; }
.stat-ic { margin-bottom: 2rpx; }
.stat-label { font-size: 22rpx; color: rgba(255, 255, 255, .76); margin-top: 6rpx; }

/* —— 卡片里的列表：去掉 .card 自带内边距，让 .list-row 自己控制 —— */
.pad-0 { padding: 0; overflow: hidden; }
.row-name { font-size: 29rpx; color: var(--ink); }
.list-row .chip { flex: none; }
.sub-time { font-size: 22rpx; color: var(--muted); flex: none; margin-left: var(--s-2); }

/* —— 展开/收起 —— */
.sec-more { display: flex; align-items: center; gap: 6rpx; }
.caret { opacity: .55; transition: transform .18s ease; }
.caret.is-open { transform: rotate(90deg); }

/* 攻略投稿行：带封面缩略图，和纯文字的社区帖行区分开 */
.sub-cover { width: 108rpx; height: 78rpx; border-radius: var(--r-xs); flex: none; background: var(--fill); }
.sub-cover-empty { display: flex; align-items: center; justify-content: center; background: var(--brand-soft); }
.sub-text { padding-left: var(--s-2); }
.sub-text .row-name { display: block; }
.sub-meta { display: flex; align-items: center; gap: var(--s-1); margin-top: 8rpx; }
.sub-meta .sub-time { margin-left: 0; }

/* —— 卡片内空态 —— */
.empty-sm { padding: 56rpx 0; }
.empty-sm .empty-ic { width: 64rpx; height: 64rpx; background-size: 64rpx 64rpx; }
.empty-sm .empty-text { font-size: 25rpx; }

/* —— 退出登录 —— */
.logout {
  display: flex; align-items: center; justify-content: center; gap: var(--s-2);
  margin: var(--s-5) var(--gap) 0; padding: 26rpx;
  color: var(--danger); font-size: 29rpx; font-weight: 500;
  background: var(--card); border: 1rpx solid var(--line); border-radius: var(--r-md);
  box-shadow: var(--sh-1);
}
.logout:active { background: var(--fill); }

/* 个人页：账目信息卡片与清楚的分区 */
page { background: #f7f8fa; }
.container { padding-bottom: 150rpx; }
.hero { padding: 30rpx 32rpx 28rpx; border-radius: 0 0 20rpx 20rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 16rpx; border: 2rpx solid rgba(255,255,255,.25); box-shadow: none; }
.user-text { margin-left: 22rpx; }
.stat-row { margin-top: 28rpx; gap: 12rpx; }
.stat { min-height: 116rpx; border-radius: 10rpx; background: rgba(255,255,255,.08); }
.stat-num { font-size: 36rpx; }
.stat-label { font-size: 21rpx; }
.section { margin: 28rpx 28rpx 12rpx; }
.card { border-radius: 12rpx; }
.list-row { padding: 22rpx 24rpx; }
.list-icon { width: 58rpx; height: 58rpx; border-radius: 12rpx; background: #edf2f6; }
.logout { border-radius: 12rpx; box-shadow: none; }
