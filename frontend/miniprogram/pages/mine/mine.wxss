/* 我的 */
.user-info { display: flex; align-items: center; margin: 24rpx 24rpx 20rpx; background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%); border: none; box-shadow: 0 14rpx 40rpx rgba(79, 90, 255, 0.32); }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.3); border: 6rpx solid rgba(255, 255, 255, 0.55); box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.2); flex-shrink: 0; }
.user-text { display: flex; flex-direction: column; margin-left: 24rpx; min-width: 0; }
.user-text .title { font-size: 34rpx; font-weight: 700; color: #fff; }
.user-text .desc { font-size: 25rpx; color: rgba(255, 255, 255, 0.86); margin-top: 8rpx; }

/* 概览三格 */
.stat-row { display: flex; margin: 0 24rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 26rpx 8rpx; margin: 0 10rpx; border-radius: 24rpx; background: #fff; box-shadow: var(--shadow); border: 1rpx solid rgba(37, 63, 183, 0.05); }
.stat:first-child { margin-left: 0; }
.stat:last-child { margin-right: 0; }
.stat-num { font-size: 38rpx; font-weight: 800; color: var(--brand); line-height: 1.2; }
.stat-label { font-size: 23rpx; color: var(--muted); margin-top: 6rpx; }
.stat:active { transform: scale(0.98); }

/* 入口列表 */
.menu-group { padding: 0; overflow: hidden; margin-top: 0; }
.row-ico { width: 52rpx; font-size: 30rpx; margin-right: 10rpx; }
.sub-list { padding: 0; overflow: hidden; margin-top: 0; }
.sub-name { font-size: 28rpx; margin: 0 16rpx; }
.sub-time { font-size: 22rpx; color: var(--muted); flex-shrink: 0; }
.chip-sm { font-size: 20rpx; padding: 3rpx 16rpx; flex-shrink: 0; }
.empty-sm { padding: 40rpx 0; }
.empty-sm .empty-text { font-size: 25rpx; }

.logout {
  margin: 40rpx 24rpx 0; text-align: center; padding: 26rpx;
  color: var(--danger); border-radius: 26rpx; font-size: 29rpx;
  background: #FFF7F9; border: 1rpx solid #FBE3EA;
}
.logout:active { background: #FFEFF2; }
