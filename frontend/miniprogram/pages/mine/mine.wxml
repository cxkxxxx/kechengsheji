<!-- 我的：账号信息 + 数据概览 + 收藏/发帖 -->
<view class="container">
  <!-- 头区：账号 + 概览 -->
  <view class="hero">
    <view class="flex">
      <image class="avatar" src="{{user.avatar || '/images/logo.jpg'}}" mode="aspectFill" />
      <view class="flex-1 user-text">
        <text class="hero-title">{{user.nickname || '未登录'}}</text>
        <text class="hero-sub">累计省下 {{savedText}} 元 · 月度目标 {{goalText}}</text>
      </view>
    </view>

    <view class="stat-row">
      <view class="stat" bindtap="toggleFavorites">
        <text class="stat-num num">{{favTotal}}</text>
        <text class="stat-label">我的收藏</text>
      </view>
      <view class="stat" bindtap="toggleMyPosts">
        <text class="stat-num num">{{postTotal}}</text>
        <text class="stat-label">社区发帖</text>
      </view>
      <view class="stat" bindtap="toggleSubs">
        <text class="stat-num num">{{subTotal}}</text>
        <text class="stat-label">攻略投稿</text>
      </view>
    </view>
  </view>

  <!-- 常用入口 -->
  <view class="section"><text class="section-title">常用功能</text></view>
  <view class="card card-flat pad-0">
    <view class="list-row" bindtap="goBill">
      <view class="list-icon"><view class="ic ic-target"></view></view>
      <text class="flex-1 row-name">省钱目标与账单分析</text>
      <view class="ic ic-sm ic-arrow"></view>
    </view>
    <view class="list-row" bindtap="goAssistant">
      <view class="list-icon"><view class="ic ic-spark"></view></view>
      <text class="flex-1 row-name">问问 AI 助手</text>
      <view class="ic ic-sm ic-arrow"></view>
    </view>
    <view class="list-row" bindtap="goSettings">
      <view class="list-icon"><view class="ic ic-user"></view></view>
      <text class="flex-1 row-name">设置</text>
      <view class="ic ic-sm ic-arrow"></view>
    </view>
  </view>

  <!-- 我的收藏 -->
  <view class="section" bindtap="toggleFavorites">
    <text class="section-title">我的收藏</text>
    <view class="sec-more">
      <text class="section-sub">{{showFav ? '收起' : '展开'}}</text>
      <view class="ic ic-sm ic-arrow caret {{showFav ? 'is-open' : ''}}"></view>
    </view>
  </view>
  <view class="card card-flat pad-0" wx:if="{{showFav}}">
    <view class="list-row" wx:for="{{favList}}" wx:key="id"
          bindtap="openFavorite" data-id="{{item.target_id}}" data-type="{{item.target_type}}">
      <view class="list-icon">
        <view class="ic ic-sm {{item.target_type === 'post' ? 'ic-comment' : 'ic-doc'}}"></view>
      </view>
      <text class="flex-1 ellipsis row-name">{{item.title || ('内容 #' + item.target_id)}}</text>
      <text class="chip chip-sm chip-grey">{{item.typeLabel}}</text>
      <text class="sub-time">{{item.timeText}}</text>
    </view>
    <view class="empty empty-sm" wx:if="{{favList.length === 0}}">
      <view class="ic ic-heart empty-ic"></view>
      <text class="empty-text">还没有收藏，去攻略页看看</text>
    </view>
  </view>

  <!-- 社区发帖 -->
  <view class="section" bindtap="toggleMyPosts">
    <text class="section-title">社区发帖</text>
    <view class="sec-more">
      <text class="section-sub" wx:if="{{postTotal}}">已发布 {{postPublished}}/{{postTotal}} · {{showPosts ? '收起' : '展开'}}</text>
      <text class="section-sub" wx:else>{{showPosts ? '收起' : '展开'}}</text>
      <view class="ic ic-sm ic-arrow caret {{showPosts ? 'is-open' : ''}}"></view>
    </view>
  </view>
  <view class="card card-flat pad-0" wx:if="{{showPosts}}">
    <view class="list-row" wx:for="{{myPosts}}" wx:key="id" bindtap="goPostDetail" data-id="{{item.id}}">
      <view class="list-icon"><view class="ic ic-comment ic-sm"></view></view>
      <text class="flex-1 ellipsis row-name">{{item.title}}</text>
      <text class="chip chip-sm {{item.statusCls}}" wx:if="{{item.statusText}}">{{item.statusText}}</text>
      <text class="sub-time">{{item.timeText}}</text>
      <view class="ic ic-sm ic-arrow"></view>
    </view>
    <view class="empty empty-sm" wx:if="{{myPosts.length === 0}}">
      <view class="ic ic-comment empty-ic"></view>
      <text class="empty-text">还没在社区发过帖</text>
      <text class="desc empty-tip">去社区点右下角「+」分享一条省钱经验</text>
    </view>
  </view>

  <!-- 攻略投稿：和上面不是一张表，用户很容易以为「发帖」包含它 -->
  <view class="section" bindtap="toggleSubs">
    <text class="section-title">攻略投稿</text>
    <view class="sec-more">
      <text class="section-sub" wx:if="{{subTotal}}">已发布 {{subPublished}}/{{subTotal}} · {{showSubs ? '收起' : '展开'}}</text>
      <text class="section-sub" wx:else>{{showSubs ? '收起' : '展开'}}</text>
      <view class="ic ic-sm ic-arrow caret {{showSubs ? 'is-open' : ''}}"></view>
    </view>
  </view>
  <view class="card card-flat pad-0" wx:if="{{showSubs}}">
    <view class="list-row" wx:for="{{mySubs}}" wx:key="id" bindtap="goArticleDetail"
          data-id="{{item.id}}" data-status="{{item.status}}">
      <image wx:if="{{item.coverUrl}}" class="sub-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view wx:else class="sub-cover sub-cover-empty"><view class="ic ic-sm ic-doc"></view></view>
      <view class="flex-1 sub-text">
        <text class="row-name ellipsis">{{item.title}}</text>
        <view class="sub-meta">
          <text class="chip chip-sm chip-grey">{{item.category}}</text>
          <text class="chip chip-sm {{item.statusCls}}">{{item.statusText}}</text>
          <text class="sub-time num">{{item.views}} 阅读</text>
        </view>
      </view>
      <view class="ic ic-sm ic-arrow"></view>
    </view>
    <view class="empty empty-sm" wx:if="{{mySubs.length === 0}}">
      <view class="ic ic-doc empty-ic"></view>
      <text class="empty-text">还没有投稿攻略</text>
      <text class="desc empty-tip">写一篇省钱经验，过审后会出现在攻略列表</text>
      <view class="btn-primary empty-btn" bindtap="goArticleCreate">去投稿</view>
    </view>
  </view>

  <view class="logout" bindtap="logout">
    <view class="ic ic-sm ic-close"></view><text>退出登录</text>
  </view>
  <view style="height: 60rpx;"></view>
</view>
