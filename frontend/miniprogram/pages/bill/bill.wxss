/* 账单页：只有本页特有的样式，通用件在 app.wxss */
.container { padding-bottom: 160rpx; }

/* 月份切换 */
.month-bar { display: flex; align-items: center; justify-content: center; padding: 24rpx 0 4rpx; }
.mb-btn { width: 88rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: var(--brand); border-radius: 16rpx; }
.mb-btn:active { background: var(--brand-soft); }
.mb-btn.disabled { color: #C9CEDD; }
.mb-label { display: flex; align-items: center; justify-content: center; min-width: 300rpx; height: 64rpx; }
.mb-month { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.mb-caret { font-size: 22rpx; color: var(--muted); margin-left: 10rpx; }

/* 总览 */
.hero-card { background: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%); border: none; box-shadow: 0 14rpx 40rpx rgba(79, 90, 255, 0.32); margin-top: 12rpx; }
.hero-card .desc { color: rgba(255, 255, 255, 0.82); }
.hero-num { font-size: 62rpx; font-weight: 800; color: #fff; line-height: 1.2; }
.hero-unit { font-size: 26rpx; font-weight: 400; margin-left: 8rpx; }
.hero-side { text-align: right; }
.trend { display: inline-block; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; background: rgba(255, 255, 255, 0.2); color: #fff; margin-bottom: 8rpx; }
.hero-actions { display: flex; margin-top: 26rpx; }
.hero-actions > view { margin-right: 16rpx; background: rgba(255, 255, 255, 0.16); border-color: rgba(255, 255, 255, 0.4); color: #fff; }
.hero-actions > view:last-child { margin-right: 0; }
.hero-actions > view:active { background: rgba(255, 255, 255, 0.28); }

/* 省钱目标 */
.goal-card .title { display: block; margin-bottom: 16rpx; }
.goal-bar { height: 16rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; margin: 8rpx 0 12rpx; }
.goal-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--brand-1) 0%, var(--brand-2) 100%); }

/* 图表 */
.chart-card { padding: 28rpx 28rpx 8rpx; }
.chart-wrap { display: flex; justify-content: center; }
.pie-canvas { width: 300px; height: 300px; }
.legend { margin-top: 8rpx; }
.legend-item { display: flex; align-items: center; padding: 12rpx 0; }
.legend-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; }
.legend-name { width: 84rpx; font-size: 26rpx; color: var(--ink-2); flex-shrink: 0; }
.legend-track { flex: 1; height: 12rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; margin: 0 16rpx; }
.legend-fill { height: 100%; border-radius: 999rpx; }
.legend-pct { width: 76rpx; text-align: right; color: var(--brand); font-weight: 600; font-size: 24rpx; }
.legend-amt { width: 150rpx; text-align: right; color: var(--muted); font-size: 24rpx; }

/* AI 建议 */
.advice-card { background: linear-gradient(135deg, #EDF0FF 0%, #E8F4FF 100%); }
.advice-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.advice-refresh { font-size: 24rpx; color: var(--brand); padding: 8rpx 24rpx; border: 2rpx solid rgba(80, 70, 229, 0.35); border-radius: 999rpx; }
.advice-refresh:active { background: #fff; }
.ai-text { font-size: 28rpx; color: #3A4060; line-height: 1.75; display: block; }
.ai-text.placeholder { color: var(--muted); }

/* 分类合计 */
.cat-list { padding: 8rpx 28rpx; }
.cat-row { display: flex; align-items: center; padding: 20rpx 0; }
.cat-row + .cat-row { border-top: 1rpx solid var(--line); }
.cat-amount { color: var(--brand); font-weight: 600; }

/* 消费明细 */
.bill-list { padding: 4rpx 0; }
.bill-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; }
.bill-row + .bill-row { border-top: 1rpx solid var(--line); }
.bill-row:active { background: #FAFBFF; }
.bill-left { display: flex; align-items: center; flex: 1; min-width: 0; }
.bill-text { display: flex; flex-direction: column; min-width: 0; }
.bill-name { font-size: 28rpx; color: var(--ink); max-width: 380rpx; }
.bill-amount { font-size: 32rpx; font-weight: 700; color: var(--ink); margin-left: 16rpx; }
.more-btn { text-align: center; padding: 22rpx; color: var(--brand); font-size: 26rpx; border-top: 1rpx solid var(--line); }

/* 空态 */
.empty-btn { margin: 28rpx 0 12rpx; padding: 18rpx 60rpx; }
.empty-tip { margin-top: 4rpx; }

/* 弹窗里的删除 */
.btn-cancel.danger { color: var(--danger); }
