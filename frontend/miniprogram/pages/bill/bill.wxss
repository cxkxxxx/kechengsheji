/* 账单页：只有本页特有的样式，通用件在 app.wxss */
.container { padding-bottom: 160rpx; }

/* —— 头区：月份切换 —— */
.mb-bar { display: flex; align-items: center; gap: var(--s-2); margin-bottom: var(--s-5); }
.mb-btn {
  width: 72rpx; height: 60rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-sm); background: rgba(255, 255, 255, .12);
}
.mb-btn:active { background: rgba(255, 255, 255, .24); }
.mb-btn.disabled { opacity: .38; }
.mb-pick { min-width: 0; }
.mb-label {
  display: flex; align-items: center; justify-content: center; gap: var(--s-1);
  height: 60rpx; padding: 0 var(--s-3);
}
.mb-month { font-size: 30rpx; font-weight: 600; color: #fff; letter-spacing: .3rpx; }
.mb-caret { transform: rotate(90deg); opacity: .7; }

/* —— 头区：总览数字 —— */
.sum-row { display: flex; align-items: flex-end; }
.sum { font-size: 68rpx; font-weight: 800; color: #fff; line-height: 1.15; margin: 6rpx 0 4rpx; }
.hero-sub { color: rgba(255, 255, 255, .82); opacity: 1; }
.sum-side { text-align: right; flex: none; }
.trend {
  display: inline-flex; align-items: center; gap: 4rpx; padding: 6rpx 18rpx;
  border-radius: var(--r-full); font-size: 24rpx; font-weight: 700;
  background: rgba(255, 255, 255, .18); color: #fff; margin-bottom: var(--s-2);
}
.trend-ic { transform: rotate(90deg); }
.trend-ic.is-up { transform: rotate(-90deg); }
.trend.up { background: rgba(229, 72, 77, .28); }
.trend.down { background: rgba(255, 255, 255, .18); }
.hero-actions { display: flex; gap: var(--s-2); margin-top: var(--s-5); }
.hero-btn {
  display: flex; align-items: center; justify-content: center; gap: var(--s-1);
  padding: 20rpx 0; border-radius: var(--r-sm); font-size: 26rpx; font-weight: 500;
  background: rgba(255, 255, 255, .16); border: 1rpx solid rgba(255, 255, 255, .34); color: #fff;
}
.hero-btn:active { background: rgba(255, 255, 255, .28); }

/* —— 省钱目标 —— */
.goal-card .title { display: block; }
.goal-bar { height: 14rpx; border-radius: var(--r-full); background: var(--fill); overflow: hidden; margin: var(--s-3) 0 var(--s-2); }
.goal-fill { height: 100%; border-radius: var(--r-full); background: linear-gradient(90deg, var(--brand) 0%, var(--brand-2) 100%); }
.goal-label { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
.goal-label .desc { flex: 1; min-width: 0; }
.goal-label .left { color: var(--ok); }
.goal-label .over { color: var(--danger); font-weight: 600; }
/* 支出上限条：接近用完转橙，超了转红 */
.goal-fill.budget { background: linear-gradient(90deg, var(--ok) 0%, #3FC98E 100%); }
.goal-fill.budget.is-over { background: linear-gradient(90deg, var(--warn) 0%, var(--danger) 100%); }
/* 第二个目标块之间留口气，两块进度条贴在一起会读不出来 */
.goal-card .goal-label:not(:first-child) { margin-top: var(--s-4); }

.goal-empty { display: flex; align-items: center; border: 1rpx dashed var(--brand-line); }
.goal-empty:active { background: var(--brand-soft); }
.goal-empty .title { display: block; font-size: 29rpx; }
.goal-empty .desc { display: block; margin-top: 6rpx; line-height: 1.5; }

/* 目标弹窗 */
.label-hint { font-size: 21rpx; color: var(--muted); font-weight: 400; margin-left: 10rpx; }
.goal-tip { display: block; margin-top: 8rpx; font-size: 21rpx; }

/* —— 图表 —— */
.chart-card { padding: var(--s-4) var(--s-4) var(--s-2); }
.chart-wrap { display: flex; justify-content: center; }
.pie-canvas { width: 300px; height: 300px; }
.legend { margin-top: var(--s-2); }
.legend-item { display: flex; align-items: center; padding: 12rpx 0; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: var(--s-2); flex: none; }
.legend-name { width: 84rpx; font-size: 26rpx; color: var(--ink-2); flex: none; }
.legend-track { flex: 1; height: 10rpx; border-radius: var(--r-full); background: var(--fill); overflow: hidden; margin: 0 var(--s-3); }
.legend-fill { height: 100%; border-radius: var(--r-full); }
.legend-pct { width: 76rpx; text-align: right; color: var(--brand); font-weight: 600; font-size: 24rpx; }
.legend-amt { width: 150rpx; text-align: right; color: var(--muted); font-size: 24rpx; }

/* —— AI 建议 —— */
.advice-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--s-3); }
.advice-refresh { flex: none; }
.ai-text { font-size: 28rpx; color: var(--ink-2); line-height: 1.75; display: block; }
.ai-text.placeholder { color: var(--muted); }
@keyframes spin { to { transform: rotate(360deg); } }
.ic.is-spin { animation: spin 1s linear infinite; }

/* —— 分类合计（表格） —— */
.cat-tbl { margin: 0 var(--gap) var(--s-3); }
.cat-tbl .legend-dot { margin-right: 12rpx; }

/* —— 消费明细 —— */
.pad-0 { padding: 0; overflow: hidden; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.bill-text { display: flex; flex-direction: column; min-width: 0; }
.bill-name { font-size: 29rpx; color: var(--ink); font-weight: 500; }
.bill-amount { font-size: 32rpx; font-weight: 700; color: var(--ink); flex: none; }
.more-btn {
  text-align: center; padding: 22rpx; color: var(--brand); font-size: 26rpx;
  border-top: 1rpx solid var(--line); background: var(--card);
}
.more-btn:active { background: var(--fill); }

/* —— 弹窗 —— */
.dialog-head { display: flex; align-items: center; justify-content: space-between; }
.dialog-x {
  width: 56rpx; height: 56rpx; border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center; background: var(--fill);
}
.dialog-x:active { background: var(--line); }
.btn-cancel.danger {
  display: flex; align-items: center; justify-content: center; gap: var(--s-1);
  color: var(--danger);
}
