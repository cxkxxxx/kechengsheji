<!-- 账单页：浅色顶栏 + 总支出/趋势卡 + 分类环形图 + 目标/明细/打卡 -->
<view class="container">
  <!-- 顶栏：月份切换（浅色 pill，取代旧深色头图） -->
  <view class="top-bar">
    <view class="tb-nav" bindtap="shiftMonth" data-d="{{-1}}">
      <view class="ic ic-sm ic-back"></view>
    </view>
    <picker class="tb-pick" mode="selector" range="{{months}}" range-key="month" bindchange="pickMonth">
      <view class="tb-month">
        <text>{{monthLabel}}</text>
        <view class="ic ic-sm ic-arrow tb-caret"></view>
      </view>
    </picker>
    <view class="tb-nav {{isCurrentMonth ? 'disabled' : ''}}" bindtap="shiftMonth" data-d="{{1}}">
      <view class="ic ic-sm ic-arrow"></view>
    </view>
  </view>

  <!-- 卡1：消费管理。只管「花了多少 / 预算剩多少」，省钱成果在下面单独一张卡 -->
  <view class="card spend-card">
    <text class="sc-label">本月总支出</text>
    <view class="sc-row">
      <text class="sc-num num">¥{{summary.totalText || '0.00'}}</text>
      <view wx:if="{{analysis.diff_pct !== null && analysis.diff_pct !== undefined}}"
            class="trend-chip {{analysis.diff > 0 ? 'up' : 'down'}}">
        <text class="num">{{analysis.diff_pct}}%</text>
      </view>
    </view>
    <text class="sc-sub">{{summary.count || 0}} 笔记录<text wx:if="{{analysis.daily_avg}}"> · 日均 {{analysis.daily_avg}} 元</text><text wx:if="{{analysis.prev_month}}"> · {{analysis.prev_month}} 共 {{analysis.prev_total}} 元</text></text>

    <!-- 预算剩余（超支红/剩余绿），一眼看到还能花多少 -->
    <view class="metric-strip" wx:if="{{plan && plan.spend_limit > 0}}">
      <view class="ms-cell">
        <text class="ms-num num {{plan.budget_over ? 'is-risk' : 'is-ok'}}">{{plan.budget_over ? '-' + plan.budget_overAmt : plan.budget_left}}</text>
        <text class="ms-label">{{plan.budget_over ? '已超支(元)' : '预算剩余(元)'}}</text>
      </view>
    </view>

    <!-- 预算进度：贴着指标条走，不单独开卡 -->
    <block wx:if="{{plan && plan.spend_limit > 0}}">
      <view class="ms-progress">
        <text class="desc">支出上限 {{plan.spend_limit}} 元 · 已花 {{plan.spend}} 元</text>
        <text class="desc {{plan.budget_over ? 'over' : 'left'}}">{{plan.budget_overText}}</text>
      </view>
      <view class="goal-bar">
        <view class="goal-fill budget {{plan.budget_over ? 'is-over' : ''}}" style="width: {{plan.budget_used > 100 ? 100 : plan.budget_used}}%"></view>
      </view>
      <text class="desc goal-hint" wx:if="{{plan.budget_perDay}}">{{plan.budget_perDay}}</text>
      <text class="ms-edit" bindtap="openGoalDialog">修改本月目标</text>
    </block>
    <!-- 没设目标时给个轻入口，不占一张卡 -->
    <view class="ms-set" wx:if="{{isCurrentMonth && !loading && !(plan && (plan.spend_limit > 0 || plan.target_amount > 0))}}"
          bindtap="openGoalDialog">
      <text class="ic ic-sm ic-target"></text>
      <text class="ms-set-text">设个月度目标，AI 分析时按它提醒超支</text>
      <view class="ic ic-sm ic-arrow"></view>
    </view>

    <canvas canvas-id="trendBars" class="trend-canvas"></canvas>
    <view class="sc-actions">
      <view class="sc-btn" bindtap="askAI">
        <view class="ic ic-sm ic-spark"></view><text>让 AI 分析</text>
      </view>
      <view class="sc-btn" bindtap="seedDemo" wx:if="{{!seeding}}">
        <view class="ic ic-sm ic-plus"></view><text>导入演示账单</text>
      </view>
      <view class="sc-btn btn-disabled" wx:else>
        <view class="ic ic-sm ic-plus"></view><text>导入中…</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{loading}}">
    <view class="skeleton" style="height: 26rpx; width: 40%; margin-bottom: 28rpx;"></view>
    <view class="skeleton" style="height: 300rpx; margin-bottom: 28rpx;"></view>
    <view class="skeleton" style="height: 26rpx; width: 78%; margin-bottom: 16rpx;"></view>
    <view class="skeleton" style="height: 26rpx; width: 56%;"></view>
  </view>

  <!-- AI 可视化 -->
  <block wx:elif="{{hasBills}}">
    <view class="card donut-card">
      <view class="dc-head">
        <text class="dc-title">钱都花在哪了</text>
        <text class="desc">{{analysis.month}}</text>
      </view>
      <view class="chart-wrap">
        <canvas canvas-id="billPie" class="pie-canvas"></canvas>
      </view>
      <view class="legend">
        <view class="legend-item" wx:for="{{analysis.categories}}" wx:key="name">
          <view class="legend-dot" style="background: {{item.color}}"></view>
          <text class="legend-name">{{item.name}}</text>
          <view class="legend-track">
            <view class="legend-fill" style="width: {{item.pct}}%; background: {{item.color}}"></view>
          </view>
          <text class="legend-pct num">{{item.pct}}%</text>
          <text class="legend-amt num">{{item.amount}}元</text>
        </view>
      </view>
    </view>

    <view class="card advice-card">
      <view class="advice-head">
        <view class="flex gap-2">
          <view class="list-icon"><view class="ic ic-spark"></view></view>
          <view class="flex-col">
            <text class="title">AI 省钱建议</text>
            <text class="desc">按 {{analysis.month}} 实际账单生成</text>
          </view>
        </view>
        <view class="btn-ghost advice-refresh" bindtap="refreshAdvice">
          <view class="ic ic-sm ic-refresh {{adviceLoading ? 'is-spin' : ''}}"></view>
          <text>{{adviceLoading ? '生成中' : '重新生成'}}</text>
        </view>
      </view>
      <text class="ai-text" wx:if="{{analysis.ai_advice}}">{{analysis.ai_advice}}</text>
      <text class="ai-text placeholder" wx:else>这份建议按当月真实账单生成，点「重新生成」让 AI 看看你的钱怎么花更省。</text>
    </view>
  </block>

  <!-- 空态 -->
  <view class="empty" wx:elif="{{!loading}}">
    <view class="ic ic-wallet empty-ic"></view>
    <text class="empty-text">{{month}} 还没有账单</text>
    <text class="desc empty-tip">也可以直接对 AI 助手说「昨晚外卖 32 块」帮你记账</text>
    <view class="btn-primary empty-btn" bindtap="openAddDialog">
      <view class="ic ic-sm ic-plus ic-light"></view><text>记第一笔</text>
    </view>
  </view>

  <!-- AI 月度解读：统计数字由程序算，AI 只负责解读。历史报告可回看 -->
  <view class="card report-card" wx:if="{{!loading}}">
    <view class="advice-head">
      <view class="flex gap-2">
        <view class="list-icon"><view class="ic ic-spark"></view></view>
        <view class="flex-col">
          <text class="title">AI 月度解读</text>
          <text class="desc">{{month}} · 金额和占比由程序统计，AI 只做解读</text>
        </view>
      </view>
      <view class="btn-ghost advice-refresh" bindtap="makeReport" wx:if="{{!report.loading && !report.empty}}">
        <view class="ic ic-sm ic-refresh {{report.loading ? 'is-spin' : ''}}"></view>
        <text>重新生成</text>
      </view>
    </view>

    <view wx:if="{{report.empty}}" class="report-empty">
      <text class="desc">{{report.message}}</text>
    </view>

    <block wx:if="{{report.data}}">
      <view class="report-limited" wx:if="{{report.data.report.data_limited}}">
        <text class="ic ic-sm ic-clock"></text><text>本月账单笔数较少，以下解读仅供参考</text>
      </view>
      <text class="report-summary">{{report.data.report.summary}}</text>
      <view class="report-point" wx:for="{{report.data.report.points}}" wx:key="title">
        <text class="rp-title">{{item.title}}</text>
        <text class="rp-text">{{item.text}}</text>
      </view>
      <view class="report-advice" wx:if="{{report.data.report.advice}}">
        <text class="rp-title">调整建议</text>
        <text class="rp-text">{{report.data.report.advice}}</text>
      </view>
      <view class="report-foot">
        <text class="desc">生成于 {{report.data.created_at || '刚刚'}}</text>
        <view class="flex gap-2">
          <picker class="rep-pick" mode="selector" range="{{report.list}}" range-key="label"
                  bindchange="pickReport" wx:if="{{report.list.length > 1}}">
            <view class="rep-btn">历史报告<text class="num"> {{report.list.length}}</text></view>
          </picker>
          <view class="rep-btn" bindtap="askReportAI">追问一句</view>
        </view>
      </view>
    </block>

    <view class="report-make" wx:if="{{!report.data && !report.empty}}"
          bindtap="makeReport">
      <view class="ic ic-spark"></view>
      <text>{{report.loading ? 'AI 正在解读本月账单…' : '生成 AI 解读：这个月的钱花在哪了、哪最能省'}}</text>
    </view>
  </view>

  <!-- 消费日历热力图：一眼看出哪天花猛了。数据直接由已加载的账单算，不额外请求接口。 -->
  <view class="card cal-card" wx:if="{{hasBills && cal.cells.length}}">
    <view class="flex-between cal-head">
      <view class="flex gap-2">
        <view class="list-icon"><view class="ic ic-chart"></view></view>
        <text class="title">哪天花得多</text>
      </view>
      <text class="desc">颜色越深当天支出越高 · 峰值 {{cal.max}} 元</text>
    </view>
    <view class="cal-week">
      <text class="cal-wd" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="cal-grid">
      <view class="cal-cell {{item.cls}}" wx:for="{{cal.cells}}" wx:key="key"
            bindtap="pickCalDay" data-day="{{item.day}}">
        <text class="cal-n">{{item.day || ''}}</text>
        <text class="cal-v">{{item.short}}</text>
      </view>
    </view>
    <view class="cal-foot">
      <text class="desc" wx:if="{{cal.picked}}">{{cal.pickedLabel}}：{{cal.pickedAmount}} 元 · {{cal.pickedCount}} 笔</text>
      <text class="desc" wx:else>点某天的格子看那天明细</text>
    </view>
  </view>

  <!-- 消费明细 -->
  <view class="section" wx:if="{{bills.length}}">
    <text class="section-title">消费明细</text>
    <text class="section-sub">点开可修改 · 长按删除</text>
  </view>
  <view class="card card-flat pad-0" wx:if="{{bills.length}}">
    <view class="list-row" wx:for="{{shownBills}}" wx:key="id"
          bindtap="openEditDialog" bindlongpress="removeBill" data-id="{{item.id}}">
      <view class="list-icon"><view class="dot" style="background: {{item.color}}"></view></view>
      <view class="flex-1 bill-text">
        <text class="bill-name ellipsis">{{item.source || item.category || '未分类'}}</text>
        <text class="desc">{{item.category}} · {{item.bill_date}}{{item.pay_channel ? ' · ' + item.pay_channel : ''}}</text>
      </view>
      <text class="bill-amount num">-{{item.amount}}</text>
      <view class="ic ic-sm ic-arrow"></view>
    </view>
    <view class="more-btn" wx:if="{{bills.length > previewCount}}" bindtap="toggleBills">
      {{showAllBills ? '收起' : '展开全部 ' + bills.length + ' 笔'}}
    </view>
  </view>

  <!-- 快捷记账：记账产品最大的流失原因就是「太麻烦」，
       常用消费预置成按钮，点一下只改金额就能入账。 -->
  <view class="card quick-card">
    <text class="title quick-title">快捷记一笔</text>
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{quickItems}}" wx:key="label"
            bindtap="quickAdd" data-i="{{index}}">
        <view class="ic ic-sm {{item.ic}}"></view>
        <text class="quick-label">{{item.label}}</text>
        <text class="quick-amt num">¥{{item.amount}}</text>
      </view>
    </view>
    <text class="desc quick-hint">点一下按默认金额入账，长按可先改金额</text>
  </view>

  <!-- 省钱成果：和上面的「消费管理」分开。只算用户确认的实际节省
       （每日打卡 + 攻略/帖子/AI 方案里记的），预算和支出不在这张卡 -->
  <view class="card save-card" wx:if="{{!loading}}">
    <view class="flex-between">
      <view class="flex gap-2">
        <view class="list-icon"><view class="ic ic-check"></view></view>
        <text class="title">省钱成果</text>
      </view>
      <view class="chip chip-ok" wx:if="{{isCurrentMonth}}">已打 {{plan ? (plan.checkin_days || 0) : 0}} 天</view>
    </view>

    <view class="save-hero">
      <text class="save-hero-num num">{{recordsTotal || '0.00'}}</text>
      <text class="save-hero-unit">{{month}} 实际已省（元）</text>
    </view>

    <block wx:if="{{plan && plan.target_amount > 0}}">
      <view class="ms-progress">
        <text class="desc">省钱目标 {{plan.target_amount}} 元</text>
        <text class="desc left">进度 {{plan.save_progress || 0}}%</text>
      </view>
      <view class="goal-bar">
        <view class="goal-fill" style="width: {{plan.save_progress > 100 ? 100 : plan.save_progress}}%"></view>
      </view>
      <text class="ms-edit" bindtap="openGoalDialog">修改本月目标</text>
    </block>

    <!-- 每日打卡：记下今天省了多少钱，这条记录就在下面的列表里 -->
    <block wx:if="{{isCurrentMonth}}">
      <view class="desc ck-desc">{{ck.checked ? '今天已记 ' + ck.todaySaved + ' 元，再提交会覆盖' : '记下今天省下的钱，上面的累计会跟着涨'}}</view>
      <view class="ck-row">
        <input class="ck-input" type="digit" placeholder="省了多少元" value="{{ck.amount}}" bindinput="onCkAmount" />
        <input class="ck-input ck-note" placeholder="省在哪了（选填）" value="{{ck.note}}" bindinput="onCkNote" maxlength="30" />
        <view class="ck-btn {{ck.submitting ? 'ck-btn-off' : ''}}" bindtap="submitCheckin">
          {{ck.submitting ? '提交中' : (ck.checked ? '改一下' : '打卡')}}
        </view>
      </view>
      <view class="ck-cal" wx:if="{{ck.cells.length}}">
        <view class="ck-cell {{item.cls}}" wx:for="{{ck.cells}}" wx:key="key">
          <text class="ck-cell-n">{{item.day}}</text>
        </view>
      </view>
    </block>

    <view class="flex-between rec-head">
      <text class="rec-title">省钱记录</text>
      <text class="desc">点开改金额 · 长按删除</text>
    </view>
    <view class="rec-list" wx:if="{{records.length}}">
      <view class="rec-row" wx:for="{{records}}" wx:key="id"
            bindtap="openRecordEdit" bindlongpress="removeRecord" data-id="{{item.id}}">
        <view class="rec-chip rec-{{item.source === '打卡' ? 'ck' : item.source === '攻略' ? 'art' : item.source === '社区经验' ? 'post' : 'ai'}}">{{item.source}}</view>
        <view class="flex-1 rec-main">
          <text class="rec-sub ellipsis" wx:if="{{item.subText}}">{{item.subText}}</text>
          <text class="rec-sub rec-sub-empty" wx:else>{{item.day}}</text>
        </view>
        <text class="rec-amt num">+{{item.amountText}}</text>
      </view>
    </view>
    <view class="empty-rec" wx:else>
      <text class="desc">这个月还没有省钱记录。在攻略或帖子详情点「记省钱」，或者上面打卡，都会进这里</text>
    </view>
  </view>

  <view class="list-padding"></view>

  <!-- 记一笔 -->
  <view class="fab" bindtap="openAddDialog">
    <view class="ic ic-plus ic-lg"></view>
  </view>

  <!-- 录入 / 编辑弹窗 -->
  <view class="mask" wx:if="{{showDialog}}" bindtap="closeAddDialog"></view>
  <view class="dialog" wx:if="{{showDialog}}">
    <view class="dialog-head">
      <view class="dialog-title">{{dialogMode === 'edit' ? '修改这笔' : '记一笔'}}</view>
      <view class="dialog-x" bindtap="closeAddDialog"><view class="ic ic-sm ic-close"></view></view>
    </view>
    <view class="form-item">
      <text class="label">金额</text>
      <input class="input" type="digit" placeholder="0.00" placeholder-class="ph" value="{{form.amount}}" bindinput="onInput" data-field="amount" />
    </view>
    <view class="form-item">
      <text class="label">分类</text>
      <view class="tags">
        <view class="tag {{form.category === item ? 'active' : ''}}" wx:for="{{categories}}" wx:key="*this"
              bindtap="selectCategory" data-cat="{{item}}">{{item}}</view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">备注</text>
      <input class="input" placeholder="用来干什么、在哪家买的，如：晚餐·阮记老面馆" placeholder-class="ph" value="{{form.source}}" bindinput="onInput" data-field="source" />
    </view>
    <view class="form-item">
      <text class="label">支付平台</text>
      <view class="tags">
        <view class="tag {{form.pay_channel === item ? 'active' : ''}}" wx:for="{{payChannels}}" wx:key="*this"
              bindtap="selectChannel" data-ch="{{item}}">{{item}}</view>
      </view>
    </view>
    <view class="form-item">
      <text class="label">交易单号</text>
      <input class="input" placeholder="选填，支付截图里的那串单号" placeholder-class="ph" value="{{form.order_no}}" bindinput="onInput" data-field="order_no" />
    </view>
    <view class="form-item">
      <text class="label">日期</text>
      <picker mode="date" value="{{form.bill_date}}" bindchange="onDateChange">
        <view class="picker flex-between">
          <text>{{form.bill_date}}</text>
          <view class="ic ic-sm ic-clock"></view>
        </view>
      </picker>
    </view>
    <view class="dialog-btns">
      <view class="btn-cancel" bindtap="closeAddDialog">取消</view>
      <view class="btn-cancel danger flex-1" wx:if="{{dialogMode === 'edit'}}" bindtap="deleteFromDialog">
        <view class="ic ic-sm ic-trash"></view><text>删除</text>
      </view>
      <view class="btn-confirm" bindtap="submitBill">确定</view>
    </view>
  </view>

  <!-- 月度目标弹窗：支出上限 + 省钱目标，至少填一个 -->
  <view class="mask" wx:if="{{showGoalDialog}}" bindtap="closeGoalDialog"></view>
  <view class="dialog" wx:if="{{showGoalDialog}}">
    <view class="dialog-head"><text class="dialog-title">本月目标</text></view>
    <view class="form-item">
      <text class="label">支出上限（元）<text class="label-hint">填 0 表示不设</text></text>
      <input class="input" type="digit" placeholder="例如 2000" placeholder-class="ph"
             value="{{goalForm.spend_limit}}" bindinput="onGoalInput" data-field="spend_limit" />
      <text class="desc goal-tip">这个月最多花多少，超了会标红提醒</text>
    </view>
    <view class="form-item">
      <text class="label">省钱目标（元）<text class="label-hint">填 0 表示不设</text></text>
      <input class="input" type="digit" placeholder="例如 500" placeholder-class="ph"
             value="{{goalForm.target_amount}}" bindinput="onGoalInput" data-field="target_amount" />
      <text class="desc goal-tip">配合「省钱打卡」累计，达标即完成</text>
    </view>
    <view class="dialog-btns">
      <view class="btn-cancel" bindtap="closeGoalDialog">取消</view>
      <view class="btn-confirm" bindtap="saveGoal">保存</view>
    </view>
  </view>

  <!-- 省钱记录编辑弹窗：只能改金额和备注，来源/关联内容要改就删了重记 -->
  <view class="mask" wx:if="{{editingRecord}}" bindtap="closeRecordEdit"></view>
  <view class="dialog" wx:if="{{editingRecord}}">
    <view class="dialog-head">
      <view class="dialog-title">改这笔省钱记录</view>
      <view class="dialog-x" bindtap="closeRecordEdit"><view class="ic ic-sm ic-close"></view></view>
    </view>
    <view class="rec-meta"><text class="chip chip-grey">{{editingRecord.source}}</text><text class="desc">{{editingRecord.day}}</text></view>
    <view class="form-item">
      <text class="label">实际省下（元）</text>
      <input class="input" type="digit" placeholder="0.00" placeholder-class="ph"
             value="{{recForm.amount}}" bindinput="onRecInput" data-field="amount" />
    </view>
    <view class="form-item">
      <text class="label">备注</text>
      <input class="input" placeholder="省在哪了" placeholder-class="ph"
             value="{{recForm.note}}" bindinput="onRecInput" data-field="note" maxlength="60" />
    </view>
    <view class="dialog-btns">
      <view class="btn-cancel" bindtap="closeRecordEdit">取消</view>
      <view class="btn-confirm" bindtap="saveRecordEdit">保存</view>
    </view>
  </view>
</view>
