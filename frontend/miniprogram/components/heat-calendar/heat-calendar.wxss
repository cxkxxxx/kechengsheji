.cal-card {
  margin: 0 36rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 1px 2px rgba(19, 23, 40, .04), 0 2px 10px rgba(19, 23, 40, .04);
}
.cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.cal-title { font-size: 28rpx; font-weight: 600; color: #1C2735; }
.cal-legend { display: flex; align-items: center; gap: 6rpx; }
.cal-lg { width: 18rpx; height: 18rpx; border-radius: 6rpx; }
.cal-lg-1 { background: rgba(58, 80, 107, .10); }
.cal-lg-2 { background: rgba(58, 80, 107, .26); }
.cal-lg-3 { background: rgba(58, 80, 107, .48); }
.cal-lg-4 { background: rgba(58, 80, 107, .74); }
.cal-lg-txt { margin-left: 8rpx; font-size: 20rpx; color: #7A8593; }
.cal-week { display: flex; margin-bottom: 8rpx; }
.cal-wd { flex: 1; text-align: center; font-size: 20rpx; color: #7A8593; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: calc(100% / 7); height: 76rpx; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  position: relative;
}
.cal-n { font-size: 20rpx; color: #7A8593; line-height: 1.1; }
.cal-v { font-size: 18rpx; line-height: 1.2; color: #536171; }
.cal-empty .cal-n, .cal-empty .cal-v { visibility: hidden; }
.cal-l0 { background: transparent; }
.cal-l1 { background: rgba(58, 80, 107, .10); border-radius: 8rpx; }
.cal-l2 { background: rgba(58, 80, 107, .26); border-radius: 8rpx; }
.cal-l3 { background: rgba(58, 80, 107, .48); border-radius: 8rpx; }
.cal-l4 { background: rgba(58, 80, 107, .74); border-radius: 8rpx; }
.cal-l4 .cal-n, .cal-l4 .cal-v { color: #fff; }
/* 今天：细描边即可，不抢热力色的信息 */
.cal-today::after {
  content: ''; position: absolute; inset: 2rpx;
  border: 2rpx solid rgba(32, 52, 77, .55); border-radius: 10rpx;
  pointer-events: none;
}
.cal-foot { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #E7EBEF; }
.cal-foot-txt { font-size: 22rpx; color: #7A8593; }
