# ===== 省活攻略 - 环境变量配置 =====
# 复制此文件为 .env 并填入真实值
# .env 文件已被 .gitignore 忽略，不会上传到 GitHub

# 数据库连接
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/fastapi_db

# 大模型 API（智谱AI GLM）
# 获取地址：https://open.bigmodel.cn/
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_API_KEY=你的智谱API密钥
LLM_MODEL=glm-4-flash

# JWT 鉴权密钥（随机字符串，建议32位以上）
SECRET_KEY=请替换为随机字符串

# 微信小程序配置（用于 code 换 openid）
WX_APPID=你的小程序appid
WX_SECRET=你的小程序secret

# RAG 向量库路径
CHROMA_DB_PATH=./data/chroma_db
