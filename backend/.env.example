# ===== 省活攻略 - 环境变量配置 =====
# 复制此文件为 .env 并填入真实值
# .env 文件已被 .gitignore 忽略，不会上传到 GitHub

# ---------- 数据库（必填）----------
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/fastapi_db

# ---------- 大模型（必填，否则 AI 助手不可用）----------
# 默认智谱 AI；换服务商只改下面这三行 + 密钥，需 OpenAI 兼容协议
# 阿里云 DashScope 示例：
#   LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   LLM_MODEL=qwen-turbo
LLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
LLM_API_KEY=你的智谱API密钥
LLM_MODEL=glm-4-flash
# 图片理解模型，必须与 LLM_API_URL 属于同一家服务
LLM_VISION_MODEL=glm-4v-flash
# 单次回复 token 上限；600 会把长菜谱静默截断在第三条中途。
# 视觉模型 glm-4v-flash 实测只收到 1024（超了返回 400 / 错误码 1210），
# 代码会按模型自动夹取，这里填大不会影响带图对话。
LLM_MAX_TOKENS=1200

# ---------- JWT（生产环境务必换掉 SECRET_KEY）----------
# 保持默认值等于任何人都能伪造 token；建议 32 位以上随机串
SECRET_KEY=请替换为随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- AI 接口限流 ----------
# 每个用户每分钟允许的 AI 对话次数，防止大模型额度被刷
RATE_LIMIT_PER_MINUTE=10

# ---------- 图片上传目录 ----------
UPLOAD_DIR=./static/uploads

# ---------- RAG 向量库（可选）----------
# 目录为空时知识库自动回落到内置省钱攻略
CHROMA_DB_PATH=./data/chroma_db

# ---------- 微信小程序（接正式登录时才需要）----------
WX_APPID=你的小程序appid
WX_SECRET=你的小程序secret

# ---------- 商品比价 ----------
# 实时价走 best-price-mcp（京东/天猫），不需要任何密钥，装包即可：
#   pip install "best-price-mcp==0.5.0" "mcp<2"
# mcp 必须锁在 2 以下：2.x 删掉了 mcp.server.fastmcp，装了 2.x 这个包直接导入失败。
# 注意它是作者自建的腾讯云函数中转、全体使用者共享一份日配额，京东侧可能整天限流；
# 查不到时自动降级为「站内价格库 + 各平台搜索直达链接」，对话不会报错。
PRICE_TIMEOUT=8          # 单次比价的外部请求超时（秒），宁可降级也不要让对话卡住
